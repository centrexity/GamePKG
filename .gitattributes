# Signed example lock hashes require identical text bytes on every platform.
* text=auto eol=lf
*.png -text
*.webm -text
*.ogv -text
*.gamepkg -text
*.gamepkgstore -text
*.zip -text
*.tar.gz -text

# Preserve the exact upstream bytes recorded in the engine provenance lock.
engines/zelda3/upstream/** -text -whitespace
engines/doom/upstream/** -text -whitespace
engines/cube2/upstream/** -text -whitespace
engines/cube2/upstream/readme_source.txt conflict-marker-size=32

# New reviewed engine and vendored inputs also retain byte-level provenance.
engines/** -text
vendor/** -text -whitespace
engines/**/upstream/** -text -whitespace
engines/**/licenses/** -text -whitespace
engines/takedawn/native-gen/runtime/softfloat/** -text -whitespace
engines/takedawn/rust-port/*.patch -text -whitespace
