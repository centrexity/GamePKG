# Signed example lock hashes require identical text bytes on every platform.
* text=auto eol=lf
*.png -text
*.webm -text
*.ogv -text
*.gamepkg -text
*.gamepkgstore -text
*.zip -text
*.tar.gz -text

# Preserve the exact upstream bytes recorded in the engine provenance lock.
engines/zelda3/upstream/** -text -whitespace
engines/doom/upstream/** -text -whitespace
