package gamepkg:engine@0.1.0;

interface host {
    asset-read: func(path: string, offset: u32, length: u32) -> option<list<u8>>;
    rom-size: func() -> option<u32>;
    rom-read: func(offset: u32, length: u32) -> option<list<u8>>;
    save-size: func() -> option<u32>;
    save-read: func(offset: u32, length: u32) -> option<list<u8>>;
    save-write: func(bytes: list<u8>) -> bool;
    draw-clear: func(rgba: u32) -> bool;
    draw-rect: func(x: f32, y: f32, width: f32, height: f32, rgba: u32) -> bool;
    draw-circle: func(x: f32, y: f32, radius: f32, rgba: u32) -> bool;
    draw-shader: func(index: u32) -> bool;
    audio-submit: func(samples: list<s16>) -> bool;
}

world game {
    import host;
    export tick: func(input: u32, state: u64) -> u64;
}
