package gamepkg:engine@0.1.0;

interface host {
  window-control: func(operation:u32,value:u32)->bool;
  file-call: func(operation:u32,request:list<u8>,capacity:u32)->tuple<s32,list<u8>>;
  input-events: func(capacity:u32)->option<list<u8>>;
  random-u64: func() -> u64;
  network-call: func(operation: u32, request: list<u8>, capacity: u32) -> tuple<s32, list<u8>>;
    rom-count: func() -> u32;
    rom-size-at: func(index: u32) -> option<u32>;
    rom-read-at: func(index: u32, offset: u32, length: u32) -> option<list<u8>>;
    achievement-unlock: func(index: u32) -> bool;
    asset-read: func(path: string, offset: u32, length: u32) -> option<list<u8>>;
    rom-size: func() -> option<u32>;
    rom-read: func(offset: u32, length: u32) -> option<list<u8>>;
    save-size: func() -> option<u32>;
    save-read: func(offset: u32, length: u32) -> option<list<u8>>;
    save-write: func(bytes: list<u8>) -> bool;
    draw-clear: func(rgba: u32) -> bool;
    draw-rect: func(x: f32, y: f32, width: f32, height: f32, rgba: u32) -> bool;
    draw-circle: func(x: f32, y: f32, radius: f32, rgba: u32) -> bool;
    draw-asset-image: func(path: string, x: f32, y: f32, width: f32, height: f32) -> bool;
    draw-asset-image-linear: func(path: string, x: f32, y: f32, width: f32, height: f32) -> bool;
    draw-image: func(x: f32, y: f32, width: f32, height: f32, pixel-width: u32, pixel-height: u32, pixels: list<u8>) -> bool;
    draw-shader-image: func(index: u32, pixel-width: u32, pixel-height: u32, pixels: list<u8>) -> bool;
    draw-shader-asset-image: func(index: u32, path: string) -> bool;
    draw-shader: func(index: u32) -> bool;
    audio-submit: func(samples: list<s16>) -> bool;
}

world game {
    import host;
    export tick: func(input: u32, state: u64) -> u64;
}
