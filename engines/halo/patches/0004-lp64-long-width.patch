@@ -0,0 +1,22 @@
+#ifndef HALO_LAYOUT_H
+#define HALO_LAYOUT_H
+
+/*
+ * Xbox `long` is 32 bits. On LP64 (Linux x86_64) `long` is 64 bits, so a
+ * `long` field would move every later member of a size-asserted struct.
+ * halo_s32 / halo_u32 are that 32-bit integer: `long` where `long` is
+ * already 32 bits (i686, Win32, Win64) and `int` on LP64. Pointer fields
+ * are not these types. They are still native pointers.
+ */
+#if defined(__LP64__)
+typedef int halo_s32;
+typedef unsigned int halo_u32;
+#else
+typedef long halo_s32;
+typedef unsigned long halo_u32;
+#endif
+
+typedef char halo_s32_is_32_bits[sizeof(halo_s32) == 4 ? 1 : -1];
