+def linux_machine_flags(sln: Any) -> List[str]:
+    """Compiler triple. The default is the historical i686 Linux target, so
+    a configure without --arch emits the same flags as before."""
+    if getattr(sln, "port_arch", "i686") == "x86_64":
+        return ["--target=x86_64-linux-gnu"]
+    return ["--target=i686-linux-gnu", "-m32"]
+
+
+def march_flag(sln: Any, windows: bool = False) -> str:
+    """Instruction set for the native x86 builds.
+
+    The default is this machine (-march=native). configure.py --portable
+    asks for a build that runs on other computers. Linux i686 and every
+    x86_64 build use -march=x86-64, which enables SSE2. Clang's
+    i686-pc-windows-msvc target ignores -march=x86-64 and then leaves SSE2
+    off, so a portable 32-bit Windows build passes -msse2. It also passes
+    -maes and -mpclmul: mbedtls includes immintrin.h before the per-function
+    target pragma, and that target does not declare the AES-NI intrinsics
+    unless the command line enables them. Calls stay behind the CPU check.
+    """
+    if not getattr(sln, "port_portable", False):
+        return "-march=native"
+    arch = getattr(sln, "port_arch", "i686")
+    if windows and arch != "x86_64":
+        return "-msse2 -maes -mpclmul"
+    return "-march=x86-64"
 
 
