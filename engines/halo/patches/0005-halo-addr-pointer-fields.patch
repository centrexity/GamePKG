diff -ru '--exclude=build' '--exclude=.git' '--exclude=config.toml' '--exclude=build.ninja' '--exclude=.ninja_deps' '--exclude=.ninja_log' a/port/linux/include/halo_layout.h b/port/linux/include/halo_layout.h
--- a/port/linux/include/halo_layout.h	2026-10-27 05:11:57.712581746 +0000
+++ b/port/linux/include/halo_layout.h	2026-10-27 05:59:05.001416996 +0000
@@ -5,18 +5,63 @@
  * Xbox `long` is 32 bits. On LP64 (Linux x86_64) `long` is 64 bits, so a
  * `long` field would move every later member of a size-asserted struct.
  * halo_s32 / halo_u32 are that 32-bit integer: `long` where `long` is
- * already 32 bits (i686, Win32, Win64) and `int` on LP64. Pointer fields
- * are not these types. They are still native pointers.
+ * already 32 bits (i686, Win32, Win64) and `int` on LP64.
+ *
+ * Pointer fields inside those same structs are halo_addr, also 4 bytes.
+ * halo_ref loads one as a host pointer. halo_ref_any stores a host pointer
+ * back, keeping the low 32 bits. On i686 every host pointer fits, so the
+ * pair is an identity. Guest data and code that the port places in the
+ * low 4 GiB fit on x86_64 as well. A pointer the port places above 4 GiB
+ * does not round-trip.
  */
 #if defined(__LP64__)
 typedef int halo_s32;
 typedef unsigned int halo_u32;
+typedef unsigned long halo_uptr;
+#elif defined(_WIN64)
+typedef long halo_s32;
+typedef unsigned long halo_u32;
+typedef unsigned long long halo_uptr;
 #else
 typedef long halo_s32;
 typedef unsigned long halo_u32;
+typedef unsigned int halo_uptr;
 #endif
 
+typedef unsigned int halo_addr;
+
 typedef char halo_s32_is_32_bits[sizeof(halo_s32) == 4 ? 1 : -1];
 typedef char halo_u32_is_32_bits[sizeof(halo_u32) == 4 ? 1 : -1];
+typedef char halo_addr_is_32_bits[sizeof(halo_addr) == 4 ? 1 : -1];
+typedef char halo_uptr_is_pointer[sizeof(halo_uptr) == sizeof(void *) ? 1 : -1];
+
+static inline void *halo_ref(halo_addr addr)
+{
+	return (void *)(halo_uptr)addr;
+}
+
+/*
+ * Store a host pointer into a halo_addr. This is a cast so a static
+ * initializer stays a constant expression (a function call would not).
+ * On i686 every pointer fits. On LP64 the low 32 bits are kept; pointers
+ * the port places above 4 GiB do not round-trip.
+ */
+#define halo_ref_any(value) ((halo_addr)(value))
+
+/* Pointer ++ / -- on a halo_addr slot. delta is in bytes, and may be negative. */
+static inline halo_addr halo_ptr_post_delta(halo_addr *slot, int delta)
+{
+	halo_addr old;
+
+	old = *slot;
+	*slot = (halo_addr)(old + (halo_addr)delta);
+	return old;
+}
+
+static inline halo_addr halo_ptr_pre_delta(halo_addr *slot, int delta)
+{
+	*slot = (halo_addr)(*slot + (halo_addr)delta);
+	return *slot;
+}
 
 #endif
