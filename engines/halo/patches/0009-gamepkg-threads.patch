+static void *thread_main(void *context);
+
+static void thread_spawn_entry(void *context)
+{
+	thread_main(context);
+}
+
+struct gamepkg_spawn
+{
+	gamepkg_thread_start start;
+	void *context;
+};
+
+static void *gamepkg_spawn_main(void *argument)
+{
+	struct gamepkg_spawn *spawn = argument;
+	gamepkg_thread_start start = spawn->start;
+	void *context = spawn->context;
+
+	free(spawn);
+	start(context);
+	return NULL;
+}
+
+#if defined(__GNUC__) && defined(__ELF__)
+__attribute__((weak))
+#endif
+int32_t gamepkg_thread_spawn(gamepkg_thread_start start, void *context, uint32_t stack_bytes)
+{
+	struct gamepkg_spawn *spawn;
+	pthread_attr_t attributes;
+	pthread_t thread;
+
+	if (!start)
+		return 0;
+	spawn = malloc(sizeof(*spawn));
+	if (!spawn)
+		return 0;
+	spawn->start = start;
+	spawn->context = context;
+	pthread_attr_init(&attributes);
+	pthread_attr_setdetachstate(&attributes, PTHREAD_CREATE_DETACHED);
+	pthread_attr_setstacksize(&attributes, stack_bytes > 0x100000 ? stack_bytes : 0x100000);
+	if (pthread_create(&thread, &attributes, gamepkg_spawn_main, spawn) != 0)
+	{
+		pthread_attr_destroy(&attributes);
+		free(spawn);
+		return 0;
+	}
+	pthread_attr_destroy(&attributes);
+	return 1;
+}
+
+#if defined(__GNUC__) && defined(__ELF__)
+__attribute__((weak))
+#endif
+void gamepkg_thread_sleep_ms(uint32_t milliseconds)
+{
+	struct timespec duration;
+
+	if (milliseconds == 0)
+	{
+		sched_yield();
+		return;
+	}
+	if (milliseconds == GAMEPKG_THREAD_SLEEP_INFINITE)
+	{
+		for (;;)
+			pause();
+	}
+	duration.tv_sec = milliseconds / 1000;
+	duration.tv_nsec = (long)(milliseconds % 1000) * 1000000L;
+	while (nanosleep(&duration, &duration) == -1 && errno == EINTR)
+		;
+}
+
+#if defined(__GNUC__) && defined(__ELF__)
+__attribute__((weak))
+#endif
+void gamepkg_thread_yield(void)
+{
+	sched_yield();
+}
