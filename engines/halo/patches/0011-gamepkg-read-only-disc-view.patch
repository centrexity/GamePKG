diff --git a/port/linux/src/gamepkg_xiso_view.inc b/port/linux/src/gamepkg_xiso_view.inc
new file mode 100644
--- /dev/null
+++ b/port/linux/src/gamepkg_xiso_view.inc
@@ -0,0 +1,282 @@
+/*
+ * GamePKG read-only disc view. Included after the original XDVDFS helpers.
+ * Only bounded directory metadata and the derived loading picture stay in RAM.
+ * Map bytes are read directly from the original, read-only disc descriptor.
+ */
+#include <pthread.h>
+#include <limits.h>
+
+#ifndef O_NONBLOCK
+#define O_NONBLOCK 0
+#endif
+
+static struct
+{
+	int mounted;
+	struct xiso_image image;
+	struct xiso_entry entries[XISO_MAXIMUM_ENTRIES + 1];
+	int count;
+	int picture_index;
+	unsigned char *picture;
+	char root[XISO_MAXIMUM_PATH];
+	struct posix_file_information information;
+} xiso_view = { .image = { .descriptor = -1 }, .picture_index = -1 };
+static pthread_mutex_t xiso_view_io_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t xiso_view_directory_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct { uint32_t token, position; int kind; } xiso_view_directories[256];
+static uint32_t xiso_view_next_token = UINT32_C(0x80000000);
+
+static int xiso_view_normalize(const char *path, char *out, size_t capacity)
+{
+	size_t i;
+	if (!path || !out || !capacity) return 0;
+	for (i = 0; path[i] && i + 1 < capacity; ++i)
+		out[i] = path[i] == '\\' ? '/' : path[i];
+	if (path[i]) return 0;
+	out[i] = 0;
+	while (i > 1 && out[i - 1] == '/') out[--i] = 0;
+	return 1;
+}
+
+/* 0: another namespace; 1: view root; 2: maps directory; 3: map filename;
+ * -1: an invalid path inside the protected maps namespace. */
+static int xiso_view_path(const char *path, char *name, size_t capacity)
+{
+	char normalized[XISO_MAXIMUM_PATH];
+	const char *tail;
+	size_t root_size, i;
+	if (!xiso_view.mounted || !xiso_view_normalize(path, normalized, sizeof(normalized)))
+		return 0;
+	root_size = strlen(xiso_view.root);
+	if (strlen(normalized) < root_size) return 0;
+	for (i = 0; i < root_size; ++i)
+		if (xiso_lower((unsigned char)normalized[i]) != xiso_lower((unsigned char)xiso_view.root[i]))
+			return 0;
+	tail = normalized + root_size;
+	if (!*tail) return 1;
+	if (*tail != '/') return 0;
+	while (*tail == '/') ++tail;
+	if (!*tail) return 1;
+	if (strlen(tail) < 4 || !xiso_name_is(tail, 4, "maps") || (tail[4] && tail[4] != '/'))
+		return 0;
+	tail += 4;
+	while (*tail == '/') ++tail;
+	if (!*tail) return 2;
+	i = strlen(tail);
+	if (i + 1 > capacity || !xiso_plain_name((const unsigned char *)tail, (int)i))
+		return -1;
+	memcpy(name, tail, i + 1);
+	return 3;
+}
+
+int xiso_view_lookup(const char *path)
+{
+	char name[256];
+	int i, kind = xiso_view_path(path, name, sizeof(name));
+	if (!kind) return -2;
+	if (kind != 3) return -1;
+	for (i = 0; i < xiso_view.count; ++i)
+		if (xiso_name_is(name, (int)strlen(name), xiso_view.entries[i].name))
+			return i;
+	return -1;
+}
+
+int xiso_view_stat(const char *path, gamepkg_path_info *info)
+{
+	char name[256];
+	int kind = xiso_view_path(path, name, sizeof(name)), index;
+	if (!kind) return 0;
+	if (!info) return -1;
+	memset(info, 0, sizeof(*info));
+	if (kind < 0) return -1;
+	if (kind == 3)
+	{
+		index = xiso_view_lookup(path);
+		if (index < 0) return -1;
+		info->kind = GAMEPKG_PATH_FILE;
+		info->size = xiso_view.entries[index].size;
+	}
+	else info->kind = GAMEPKG_PATH_DIRECTORY;
+	info->flags = GAMEPKG_PATH_READ_ONLY;
+	info->modification_seconds = xiso_view.information.modification_seconds;
+	info->modification_nanoseconds = xiso_view.information.modification_nanoseconds;
+	info->access_seconds = xiso_view.information.access_seconds;
+	info->access_nanoseconds = xiso_view.information.access_nanoseconds;
+	info->creation_seconds = xiso_view.information.creation_seconds;
+	info->creation_nanoseconds = xiso_view.information.creation_nanoseconds;
+	return kind == 3 ? 1 : 2;
+}
+
+int xiso_view_source_fd(void)
+{
+	return xiso_view.mounted ? xiso_view.image.descriptor : -1;
+}
+
+uint64_t xiso_view_size(int index)
+{
+	return xiso_view.mounted && index >= 0 && index < xiso_view.count ?
+		(uint64_t)xiso_view.entries[index].size : 0;
+}
+
+int32_t xiso_view_read(int index, uint64_t offset, void *out, uint32_t length)
+{
+	uint64_t available, absolute;
+	int okay;
+	if (!xiso_view.mounted || index < 0 || index >= xiso_view.count || (!out && length))
+	{ errno = EINVAL; return -1; }
+	if (offset >= xiso_view_size(index) || !length) return 0;
+	available = xiso_view_size(index) - offset;
+	if (length > available) length = (uint32_t)available;
+	if (length > INT32_MAX) length = INT32_MAX;
+	if (index == xiso_view.picture_index)
+	{
+		memcpy(out, xiso_view.picture + (size_t)offset, length);
+		return (int32_t)length;
+	}
+	absolute = xiso_sector_offset(&xiso_view.image, xiso_view.entries[index].sector);
+	if (absolute > xiso_view.image.size || offset > xiso_view.image.size - absolute ||
+		length > xiso_view.image.size - absolute - offset)
+	{ errno = EIO; return -1; }
+	pthread_mutex_lock(&xiso_view_io_lock);
+	okay = xiso_read(&xiso_view.image, absolute + offset, out, length);
+	pthread_mutex_unlock(&xiso_view_io_lock);
+	if (!okay) { errno = EIO; return -1; }
+	return (int32_t)length;
+}
+
+int xiso_view_dir_open(const char *path, uint32_t *handle)
+{
+	char name[256];
+	unsigned i;
+	int kind = xiso_view_path(path, name, sizeof(name));
+	if (!kind) return -2;
+	if (!handle || (kind != 1 && kind != 2)) return 0;
+	pthread_mutex_lock(&xiso_view_directory_lock);
+	for (i = 0; i < 256; ++i)
+		if (!xiso_view_directories[i].token && xiso_view_next_token != UINT32_MAX)
+		{
+			xiso_view_directories[i].token = xiso_view_next_token++;
+			xiso_view_directories[i].position = 0;
+			xiso_view_directories[i].kind = kind;
+			*handle = xiso_view_directories[i].token;
+			pthread_mutex_unlock(&xiso_view_directory_lock);
+			return 1;
+		}
+	pthread_mutex_unlock(&xiso_view_directory_lock);
+	return 0;
+}
+
+int32_t xiso_view_dir_read(uint32_t handle, uint8_t *name, uint32_t capacity)
+{
+	unsigned i;
+	int32_t result = -1;
+	if (!(handle & UINT32_C(0x80000000))) return -2;
+	if (!name || !capacity) return -1;
+	pthread_mutex_lock(&xiso_view_directory_lock);
+	for (i = 0; i < 256; ++i)
+		if (xiso_view_directories[i].token == handle)
+		{
+			uint32_t position = xiso_view_directories[i].position;
+			const char *entry = NULL;
+			if (xiso_view_directories[i].kind == 1)
+			{ if (!position) entry = "maps"; }
+			else if (position < (uint32_t)xiso_view.count)
+				entry = xiso_view.entries[position].name;
+			if (!entry) result = 0;
+			else if (strlen(entry) + 1 <= capacity)
+			{
+				memcpy(name, entry, strlen(entry) + 1);
+				result = (int32_t)strlen(entry);
+				++xiso_view_directories[i].position;
+			}
+			break;
+		}
+	pthread_mutex_unlock(&xiso_view_directory_lock);
+	return result;
+}
+
+int xiso_view_dir_close(uint32_t handle)
+{
+	unsigned i;
+	if (!(handle & UINT32_C(0x80000000))) return 0;
+	pthread_mutex_lock(&xiso_view_directory_lock);
+	for (i = 0; i < 256; ++i)
+		if (xiso_view_directories[i].token == handle)
+		{ memset(&xiso_view_directories[i], 0, sizeof(xiso_view_directories[i])); break; }
+	pthread_mutex_unlock(&xiso_view_directory_lock);
+	return 1;
+}
+
+int xiso_view_mount(const char *image_path, const char *root, char *error, int error_size)
+{
+	struct xiso_image image = { .descriptor = -1 };
+	struct xiso_entry *entries = NULL, xbe = {0};
+	unsigned char *table = NULL, *picture = NULL;
+	struct posix_file_information information;
+	posix_ulong low, high;
+	unsigned long sector, size, maps_sector, maps_size;
+	int count, i, chosen, oom, has_ui = 0, has_picture = 0;
+	char normalized[XISO_MAXIMUM_PATH];
+	if (xiso_view.mounted)
+	{ xiso_error(error, error_size, "The disc view is already mounted."); return 0; }
+	if (!image_path || !xiso_view_normalize(root, normalized, sizeof(normalized)) ||
+		strlen(normalized) < 2 || (normalized[0] != '/' && !(normalized[1] == ':')))
+	{ xiso_error(error, error_size, "The disc view needs an absolute private data root."); return 0; }
+	image.descriptor = open(image_path, O_RDONLY | O_LARGEFILE | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+	if (image.descriptor < 0 || posix_seek(image.descriptor, 0, 0, SEEK_END, &low, &high) != 0 ||
+		posix_fstat(image.descriptor, &information) != 0)
+		goto damaged;
+	image.size = (uint64_t)high << 32 | low;
+	if (image.size < XISO_DESCRIPTOR_OFFSET + XISO_SECTOR_SIZE || image.size > (UINT64_C(8) << 30))
+		goto damaged;
+	entries = malloc(sizeof(*entries) * XISO_MAXIMUM_ENTRIES);
+	if (!entries || !xiso_find_volume(&image, &sector, &size)) goto damaged;
+	table = xiso_read_table(&image, sector, size, &oom);
+	if (!table) goto damaged;
+	count = xiso_walk_table_mode(table, size, 0, entries, 1);
+	if (count < 0) goto damaged;
+	for (i = 0; i < count; ++i)
+		if (xiso_name_is(entries[i].name, (int)strlen(entries[i].name), "default.xbe")) xbe = entries[i];
+	count = xiso_walk_table_mode(table, size, 1, entries, 1);
+	free(table); table = NULL;
+	if (count < 0 || (chosen = xiso_maps_folder(entries, count)) >= count) goto damaged;
+	maps_sector = entries[chosen].sector; maps_size = entries[chosen].size;
+	table = xiso_read_table(&image, maps_sector, maps_size, &oom);
+	if (!table) goto damaged;
+	count = xiso_walk_table_mode(table, maps_size, 0, entries, 1);
+	free(table); table = NULL;
+	if (count < 0) goto damaged;
+	for (i = 0; i < count; ++i)
+	{
+		uint64_t start = xiso_sector_offset(&image, entries[i].sector);
+		if (entries[i].size && (start > image.size || entries[i].size > image.size - start)) goto damaged;
+		has_ui |= xiso_name_is(entries[i].name, (int)strlen(entries[i].name), "ui.map");
+		has_picture |= xiso_name_is(entries[i].name, (int)strlen(entries[i].name), "loading.tga");
+	}
+	if (!has_ui) goto damaged;
+	if (!has_picture) picture = xiso_loading_picture(&image, &xbe);
+	xiso_view.image = image;
+	memcpy(xiso_view.entries, entries, (size_t)count * sizeof(*entries));
+	xiso_view.count = count;
+	xiso_view.information = information;
+	strcpy(xiso_view.root, normalized);
+	xiso_view.picture = picture;
+	if (picture)
+	{
+		struct xiso_entry *entry = &xiso_view.entries[count];
+		memset(entry, 0, sizeof(*entry));
+		strcpy(entry->name, "loading.tga");
+		entry->size = XISO_LOADING_TGA_SIZE;
+		xiso_view.picture_index = count;
+		++xiso_view.count;
+	}
+	xiso_view.mounted = 1;
+	free(entries);
+	platform_log("GamePKG: original disc mounted read-only; %d map files, no extraction.", count);
+	return 1;
+damaged:
+	xiso_error(error, error_size, "Could not mount the selected Xbox disc: unreadable or invalid directory data.");
+	free(table); free(entries); free(picture);
+	if (image.descriptor >= 0) close(image.descriptor);
+	return 0;
+}
