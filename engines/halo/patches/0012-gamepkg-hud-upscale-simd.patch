--- /dev/null
+++ b/port/linux/src/gamepkg_hud_upscale.inc
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later
+ * GamePKG adaptation of OpenCE's original HUD upscaler.
+ * Parallelize BGRA channels while preserving every tap and rounding step.
+ */
+/* Same Catmull-Rom tap order and rounding as the original scalar kernel. */
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#if defined(__SSE2__)
+#include <emmintrin.h>
+#endif
+static void gamepkg_hud_weights(float t, float *weights)
+{
+    float square=t*t, cube=square*t;
+    weights[0]=-0.5f*t+square-0.5f*cube;
+    weights[1]=1.0f-2.5f*square+1.5f*cube;
+    weights[2]=0.5f*t+2.0f*square-1.5f*cube;
+    weights[3]=-0.5f*square+0.5f*cube;
+}
+unsigned char *hud_hires_upscale_pixels(const unsigned char *bgra,unsigned long width,unsigned long height)
+{
+    static const float phases[4]={0.625f,0.875f,0.125f,0.375f};
+    float weights[4][4];
+    long columns[1024][4];
+    unsigned long x,y,phase;
+    unsigned char *out;
+    if(!bgra||!width||!height||width>256||height>256)return NULL;
+    out=malloc(width*height*16*4);
+    if(!out)return NULL;
+    for(phase=0;phase<4;phase++)gamepkg_hud_weights(phases[phase],weights[phase]);
+    for(x=0;x<width*4;x++)
+    {
+        long ix=(long)(x/4)-((x&3)<2), column;
+        for(column=0;column<4;column++)
+        {
+            long px=ix+column-1;
+            if(px<0)px=0;
+            if(px>=(long)width)px=width-1;
+            columns[x][column]=px*4;
+        }
+    }
+    for(y=0;y<height*4;y++)
+    {
+        long iy=(long)(y/4)-((y&3)<2), row;
+        const unsigned char *rows[4];
+        const float *wy=weights[y&3];
+        for(row=0;row<4;row++)
+        {
+            long py=iy+row-1;
+            if(py<0)py=0;
+            if(py>=(long)height)py=height-1;
+            rows[row]=bgra+py*width*4;
+        }
+        for(x=0;x<width*4;x++)
+        {
+            const float *wx=weights[x&3];
+            unsigned char *destination=out+(y*width*4+x)*4;
+#if defined(__SSE2__)
+            __m128 value=_mm_setzero_ps();
+            __m128i zero=_mm_setzero_si128();
+            long column;
+            for(row=0;row<4;row++)
+                for(column=0;column<4;column++)
+                {
+                    int32_t packed;
+                    __m128i lanes;
+                    __m128 sample;
+                    memcpy(&packed,rows[row]+columns[x][column],4);
+                    lanes=_mm_unpacklo_epi8(_mm_cvtsi32_si128(packed),zero);
+                    lanes=_mm_unpacklo_epi16(lanes,zero);
+                    sample=_mm_cvtepi32_ps(lanes);
+                    value=_mm_add_ps(value,_mm_mul_ps(_mm_mul_ps(sample,_mm_set1_ps(wy[row])),_mm_set1_ps(wx[column])));
+                }
+            value=_mm_min_ps(_mm_max_ps(value,_mm_setzero_ps()),_mm_set1_ps(255.0f));
+            value=_mm_add_ps(value,_mm_set1_ps(0.5f));
+            {
+                __m128i lanes=_mm_cvttps_epi32(value);
+                uint32_t packed;
+                lanes=_mm_shuffle_epi32(lanes,_MM_SHUFFLE(3,0,1,2));
+                lanes=_mm_packs_epi32(lanes,zero);
+                lanes=_mm_packus_epi16(lanes,zero);
+                packed=(uint32_t)_mm_cvtsi128_si32(lanes);
+                memcpy(destination,&packed,4);
+            }
+#else
+            unsigned long channel;
+            for(channel=0;channel<4;channel++)
+            {
+                unsigned long source_channel=channel==0?2:channel==2?0:channel;
+                float value=0.0f;
+                long column;
+                for(row=0;row<4;row++)
+                    for(column=0;column<4;column++)
+                        value+=rows[row][columns[x][column]+source_channel]*wy[row]*wx[column];
+                destination[channel]=(unsigned char)(value<0?0:value>255?255:value+0.5f);
+            }
+#endif
+        }
+    }
+    return out;
+}
