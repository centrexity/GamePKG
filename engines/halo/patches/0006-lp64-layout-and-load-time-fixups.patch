@@ -41,10 +41,13 @@
 }
 
 /*
- * Store a host pointer into a halo_addr. This is a cast so a static
- * initializer stays a constant expression (a function call would not).
- * On i686 every pointer fits. On LP64 the low 32 bits are kept; pointers
- * the port places above 4 GiB do not round-trip.
+ * Store a host pointer into a halo_addr. A function call is not a
+ * constant, so this is a cast. On i686 the cast of a pointer is a
+ * compile-time constant and every pointer fits. On LP64 and Win64 the
+ * cast of a real pointer is not a constant: file-scope initializers
+ * store 0 there and a constructor with priority 100 writes the low 32
+ * bits before main. NULL is a constant on those ABIs and stays in the
+ * initializer. A pointer the port places above 4 GiB does not round-trip.
  */
 #define halo_ref_any(value) ((halo_addr)(value))
 
