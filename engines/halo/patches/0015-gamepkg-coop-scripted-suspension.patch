+/* The original setter also clears velocity and airborne state. Apply it on
+transitions only, so a repeated snapshot does not keep resetting a unit. */
+static void distributed_apply_scripted_suspension(
+	long unit_index,
+	struct distributed_unit_state const *state)
+{
+	if (network_coop_active())
+	{
+		struct unit_datum *unit = unit_get(unit_index);
+		boolean suspended = TEST_FLAG(state->unit_flags, _distributed_unit_suspended_bit);
+
+		if (TEST_FLAG(unit->unit.flags, _unit_suspended_bit) != suspended)
+			unit_scripting_suspended(unit_index, suspended);
 	}
