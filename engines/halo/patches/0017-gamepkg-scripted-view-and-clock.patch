 /* (a client) the host's word on a player's unit */
+/* Invert the original player's own aiming conversion. The engine's seat
+   basis depends on vehicle up and camera flags, not the full animated
+   parent node transform. Sampling its three canonical axes preserves
+   those original rules for tilted and third-person seats alike. */
+static void gamepkg_scripted_view_local_facing(long player_index,
+    real_vector3d const *world, real_vector3d *local)
+{
+    real_euler_angles2d angles = { 0.0f, 0.0f };
+    real_vector3d axes[3];
+    player_aiming_vector_from_facing(player_index, &axes[0], &angles);
+    angles.yaw = _pi * 0.5f;
+    player_aiming_vector_from_facing(player_index, &axes[1], &angles);
+    angles.yaw = 0.0f;
+    angles.pitch = _pi * 0.5f;
+    player_aiming_vector_from_facing(player_index, &axes[2], &angles);
+    local->i = dot_product3d(world, &axes[0]);
+    local->j = dot_product3d(world, &axes[1]);
+    local->k = dot_product3d(world, &axes[2]);
+}
+
+static void gamepkg_apply_scripted_view(long unit_index, struct player_datum *player, struct distributed_unit_state const *state)
+{
+    real_vector3d vectors[7];
+    struct unit_datum *unit;
+    short index;
+    if (!network_coop_active() || !state->scripted_view)
+        return;
+    for (index = 0; index < 7; index++)
+    {
+        real length2;
+        distributed_vector_unpack(&state->scripted_vectors[index], DISTRIBUTED_UNIT_SCALE, &vectors[index]);
+        if (index == 3 || index == 6)
+            continue;
+        length2 = dot_product3d(&vectors[index], &vectors[index]);
+        if (length2 < 0.5f || length2 > 1.5f)
+            return;
+        normalize3d(&vectors[index]);
+    }
+    unit = unit_get(unit_index);
+    csmemcpy(&unit->unit.desired_facing_vector, vectors, sizeof(vectors));
+    if (player->local_player_index != NONE)
+    {
+        real_vector3d forward = vectors[0];
+        if (unit->object.parent_object_index != NONE)
+        {
+            long player_index = DATUM_INDEX_NEW(state->player_index, player->identifier);
+            gamepkg_scripted_view_local_facing(player_index, &vectors[0], &forward);
+        }
+        player_control_set_facing(player->local_player_index, &forward);
+    }
+}
