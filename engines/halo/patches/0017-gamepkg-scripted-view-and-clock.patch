+/* Keep a client near fresh host timestamps without rewinding time.
+The latest host stamp is projected by its receive age and half the measured
+round trip; two ticks cover quantization. Pause excess client ticks after a
+host hitch instead of leaving its clock permanently ahead. */
+static boolean gamepkg_clock_slew_valid;
+static halo_u32 gamepkg_clock_slew_at;
+static long gamepkg_clock_slew_tick = NONE;
+
+long gamepkg_distributed_client_ticks(long requested)
+{
+    long long projected;
+    long current;
+    long transit = 0;
+    halo_u32 now, age;
+    boolean valid_ping;
+    if (requested <= 0) return 0;
+    if (game_connection() != _game_connection_network_client ||
+        distributed_host_time < 0 || distributed_host_time > 0x3FFFFFFF)
+    {
+        gamepkg_clock_slew_valid = FALSE;
+        gamepkg_clock_slew_tick = NONE;
+        return requested;
+    }
+    valid_ping = distributed_own_ping_valid && distributed_own_ping_milliseconds >= 0.0f &&
+        distributed_own_ping_milliseconds <= MAXIMUM_PING_MILLISECONDS;
+    if (valid_ping)
+        transit = (long)(distributed_own_ping_milliseconds * 0.5f);
+    now = (halo_u32)system_milliseconds();
+    age = (halo_u32)(now - distributed_host_time_received);
+    projected = (long long)distributed_host_time +
+        ((long long)age + transit) * TICKS_PER_SECOND / 1000 + 2;
+    current = game_time_get();
+    if (gamepkg_clock_slew_tick != NONE && current < gamepkg_clock_slew_tick)
+        gamepkg_clock_slew_valid = FALSE;
+    gamepkg_clock_slew_tick = current;
+    if (projected <= current) return 0;
+    if (projected - current < requested) return (long)(projected - current);
+    /* A loading stall may leave the client behind permanently. Execute
+       one extra complete simulation tick at most every 250 ms until the
+       measured host projection is within its two-tick quantization slack.
+       No zero-tick render frame, stale clock, invalid RTT, menu or host is
+       advanced. Never rewind time, skip simulation or replace local input. */
+    if (valid_ping && age <= 1000 && requested < TICKS_PER_SECOND &&
+        projected - current > requested + 2 &&
+        (!gamepkg_clock_slew_valid || (halo_u32)(now - gamepkg_clock_slew_at) >= 250))
+    {
+        gamepkg_clock_slew_valid = TRUE;
+        gamepkg_clock_slew_at = now;
+        return requested + 1;
+    }
+    return requested;
 }
 
