+    m->video = av_find_best_stream(m->format, AVMEDIA_TYPE_VIDEO, -1, -1, NULL, 0);
+    m->audio = av_find_best_stream(m->format, AVMEDIA_TYPE_AUDIO, -1, -1, NULL, 0);
+    if (m->video < 0 || (audio_streams && m->audio < 0)) goto invalid;
+    AVStream *video = m->format->streams[m->video];
+    if (video->codecpar->codec_id != AV_CODEC_ID_BINKVIDEO || video->codecpar->width < 1 ||
+        video->codecpar->height < 1 || video->codecpar->width > 2048 || video->codecpar->height > 2048 ||
+        video->duration < 1 || video->duration > 1000000) goto invalid;
+    m->fps = video->avg_frame_rate;
+    if (m->fps.num < 1 || m->fps.den < 1 || m->fps.num > 1000000 || m->fps.den > 1000000 ||
+        m->fps.num < m->fps.den || (int64_t)m->fps.num > (int64_t)240 * m->fps.den) goto invalid;
+    m->video_codec = movie_codec(m, m->video); if (!m->video_codec) goto invalid;
+    int planes = av_pix_fmt_count_planes(m->video_codec->pix_fmt);
+    if (planes < 1 || planes > 4) goto invalid;
+    m->minimum_video_packet = planes * 4 + (header[3] >= 'i' ? 4 : 0) + (planes == 4 && header[3] >= 'i' ? 4 : 0);
+    m->Width = (uint32_t)video->codecpar->width; m->Height = (uint32_t)video->codecpar->height;
+    /* The pinned Bink demuxer stores the header's frame count in duration,
+       with a time base of exactly one video frame. */
+    m->Frames = (uint32_t)video->duration; m->FrameNum = 1; m->pending = 1;
+    if (m->audio >= 0) {
+        AVCodecParameters *p = m->format->streams[m->audio]->codecpar;
+        if ((p->codec_id != AV_CODEC_ID_BINKAUDIO_RDFT && p->codec_id != AV_CODEC_ID_BINKAUDIO_DCT) ||
+            p->ch_layout.nb_channels < 1 || p->ch_layout.nb_channels > 6 || p->sample_rate < 8000 || p->sample_rate > 192000) goto invalid;
+        m->audio_codec = movie_codec(m, m->audio); if (!m->audio_codec) goto invalid;
+        m->channels = m->audio_codec->ch_layout.nb_channels; m->rate = m->audio_codec->sample_rate;
+        if (movie_sound_requested && SDL_WasInit(SDL_INIT_AUDIO) && config_boolean("audio.enabled")) {
+            SDL_AudioSpec spec = { .format = SDL_AUDIO_F32, .channels = m->channels, .freq = m->rate };
+            const char *device = config_string("audio.output_device");
+            SDL_AudioDeviceID id = platform_audio_device(0, device && *device ? device : "default");
+            m->output = SDL_OpenAudioDeviceStream(id, &spec, NULL, NULL);
+            if (!m->output && id != SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK)
+                m->output = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, NULL, NULL);
+            if (!m->output) platform_log("movie audio device: %s", SDL_GetError());
+        }
+    }
+    m->packet = av_packet_alloc(); m->frame = av_frame_alloc(); m->rgb = av_frame_alloc(); m->scale = sws_alloc_context();
+    if (!m->packet || !m->frame || !m->rgb || !m->scale) goto invalid;
+    platform_log("movie opened in place: %s (%ux%u, %u frames)", normalized + 8, m->Width, m->Height, m->Frames);
+    movie_leave(&state); return m;
+invalid:
+    if (!m->failed) platform_log("movie playback: missing or invalid bounded original-disc movie: %.511s", name ? name : "(null)");
+    movie_dispose(m); movie_leave(&state); return NULL;
+}
+static int movie_audio(HBINK m, AVFrame *frame) {
+    if ((frame->format != AV_SAMPLE_FMT_FLTP && frame->format != AV_SAMPLE_FMT_FLT) ||
+        frame->ch_layout.nb_channels != m->channels || frame->sample_rate != m->rate ||
+        frame->nb_samples < 0 || frame->nb_samples > 65536) return AVERROR_INVALIDDATA;
+    /* Carry fractional samples across loops instead of accumulating an A/V
+       offset for frame rates such as 2997/100. Only codec padding is trimmed. */
+    uint64_t cycle = m->decoded / m->Frames;
+    if (cycle >= (uint64_t)INT64_MAX / m->Frames) return AVERROR_INVALIDDATA;
+    int64_t begin = (int64_t)(cycle * m->Frames), end = begin + m->Frames;
+    int64_t first = av_rescale_rnd(begin, (int64_t)m->rate * m->fps.den, m->fps.num, AV_ROUND_DOWN);
+    int64_t last = av_rescale_rnd(end, (int64_t)m->rate * m->fps.den, m->fps.num, AV_ROUND_DOWN);
+    if (first < 0 || last < first) return AVERROR_INVALIDDATA;
+    uint64_t limit = (uint64_t)(last - first);
+    uint64_t remaining = limit > m->audio_samples ? limit - m->audio_samples : 0;
+    int count = (uint64_t)frame->nb_samples < remaining ? frame->nb_samples : (int)remaining;
+    size_t total = (size_t)count * (unsigned)m->channels;
+    if (total > m->interleaved_samples) {
+        float *samples = av_realloc_array(m->interleaved, total, sizeof(float));
+        if (!samples) return AVERROR(ENOMEM);
+        m->interleaved = samples; m->interleaved_samples = total;
+    }
+    for (int sample = 0; sample < count; ++sample) for (int channel = 0; channel < m->channels; ++channel) {
+        float value = frame->format == AV_SAMPLE_FMT_FLTP ? ((float *)frame->extended_data[channel])[sample] :
+            ((float *)frame->data[0])[(size_t)sample * (unsigned)m->channels + (unsigned)channel];
+        if (!isfinite(value)) return AVERROR_INVALIDDATA;
+        m->interleaved[(size_t)sample * (unsigned)m->channels + (unsigned)channel] = value;
+    }
+    if (m->output && total) {
+        int queued = SDL_GetAudioStreamQueued(m->output);
+        if (queued < 0 || (uint64_t)queued + total * sizeof(float) > (uint64_t)m->rate * (unsigned)m->channels * sizeof(float) * 2) return AVERROR_INVALIDDATA;
+        double gain = config_real("audio.volume");
+        if (!isfinite(gain)) gain = 0;
+        if (gain < 0) gain = 0;
+        if (gain > 1) gain = 1;
+        if (!SDL_SetAudioStreamGain(m->output, (float)gain) ||
+            !SDL_PutAudioStreamData(m->output, m->interleaved, (int)(total * sizeof(float)))) return AVERROR(EIO);
+    }
+    m->audio_samples += (unsigned)count;
+    m->total_audio_samples += (unsigned)count;
+    return 0;
+}
+long __stdcall BinkDoFrame(HBINK m) {
+    if (!m || m->failed) return 1;
+    if (!m->pending) return 0;
+    struct movie_fp state; movie_enter(&state);
+    if (m->FrameNum > m->Frames) {
+        int error = av_seek_frame(m->format, m->video, 0, AVSEEK_FLAG_BACKWARD);
+        if (error < 0) { movie_failure(m, "rewind movie", error); goto failed; }
+        avcodec_flush_buffers(m->video_codec); if (m->audio_codec) avcodec_flush_buffers(m->audio_codec);
+        m->FrameNum = 1; m->audio_samples = 0;
+    }
+    for (unsigned packets = 0; packets < 128; ++packets) {
+        int error = av_read_frame(m->format, m->packet);
+        if (error < 0) { movie_failure(m, "read complete movie frame", error); goto failed; }
+        if ((m->packet->flags & AV_PKT_FLAG_CORRUPT) ||
+            (m->packet->stream_index == m->video && m->packet->size < m->minimum_video_packet))
+        { movie_failure(m, "truncated or corrupt movie packet", AVERROR_INVALIDDATA); goto failed; }
+        AVCodecContext *codec = m->packet->stream_index == m->video ? m->video_codec :
+            m->packet->stream_index == m->audio ? m->audio_codec : NULL;
+        int video = m->packet->stream_index == m->video;
+        uint64_t began = SDL_GetTicksNS();
+        if (codec) {
+            error = avcodec_send_packet(codec, m->packet); av_packet_unref(m->packet);
+            if (error < 0) { movie_failure(m, "submit compressed frame", error); goto failed; }
+            while ((error = avcodec_receive_frame(codec, m->frame)) >= 0) {
+                if (video) {
+                    if (m->frame->width != (int)m->Width || m->frame->height != (int)m->Height) error = AVERROR_INVALIDDATA;
+                    else {
+                        av_frame_unref(m->rgb); m->rgb->format = AV_PIX_FMT_BGRA; m->rgb->width = (int)m->Width; m->rgb->height = (int)m->Height;
+                        error = sws_scale_frame(m->scale, m->rgb, m->frame);
+                    }
+                    av_frame_unref(m->frame);
+                    if (error < 0) { movie_failure(m, "decode original movie pixels", error); goto failed; }
+                    m->video_ns += SDL_GetTicksNS() - began; m->LastFrameNum = m->FrameNum;
+                    ++m->decoded; m->pending = 0; movie_leave(&state); return 0;
+                }
+                error = movie_audio(m, m->frame); av_frame_unref(m->frame);
+                if (error < 0) { movie_failure(m, "decode movie audio", error); goto failed; }
+            }
+            if (error != AVERROR(EAGAIN) && error != AVERROR_EOF) { movie_failure(m, "finish packet", error); goto failed; }
+        } else av_packet_unref(m->packet);
+        if (!video) m->audio_ns += SDL_GetTicksNS() - began;
+    }
+    movie_failure(m, "missing bounded video packet", AVERROR_INVALIDDATA);
+failed:
+    av_packet_unref(m->packet); movie_leave(&state); return 1;
+}
+void __stdcall BinkNextFrame(HBINK m) { if (m && !m->failed && !m->pending) { ++m->FrameNum; m->pending = 1; } }
+long __stdcall BinkHasError(HBINK m) { return !m || m->failed; }
+void __stdcall BinkSetPlaybackError(HBINK m) { if (m) movie_failure(m, "native movie texture", AVERROR(EIO)); }
+void __stdcall BinkPresented(HBINK m) {
+    if (!m || m->failed) return;
+    ++m->presentations;
+    if (m->started) return;
+    struct movie_fp state; movie_enter(&state);
+    m->start_ns = SDL_GetTicksNS();
+    m->started = 1;
+    platform_log("movie playback started: first frame submitted");
+    if (m->output && !SDL_ResumeAudioStreamDevice(m->output)) movie_failure(m, "start movie audio", AVERROR(EIO));
+    movie_leave(&state);
+}
+long __stdcall BinkWait(HBINK m) {
+    if (!m || m->failed || !m->started) return 0;
+    uint64_t offset = (uint64_t)av_rescale((int64_t)m->decoded, INT64_C(1000000000) * m->fps.den, m->fps.num);
+    uint64_t now = SDL_GetTicksNS();
+    if (now - m->start_ns >= offset) return 0;
+    uint64_t left = offset - (now - m->start_ns);
+    SDL_DelayPrecise(left < UINT64_C(1000000) ? left : UINT64_C(1000000)); return 1;
+}
+long __stdcall BinkCopyToBuffer(HBINK m, void *destination, long pitch, unsigned long height,
+    unsigned long x, unsigned long y, unsigned long flags) {
+    if (!m || m->failed || !m->rgb->data[0]) return 1;
+    if (!destination || (flags & 255) != 3 || pitch <= 0 ||
+        (unsigned long)pitch / 4 < m->Width || x > (unsigned long)pitch / 4 - m->Width ||
+        height < m->Height || y > height - m->Height ||
+        (unsigned long)pitch > SIZE_MAX / height) { movie_failure(m, "movie destination bounds", AVERROR(EINVAL)); return 1; }
+    uint64_t began = SDL_GetTicksNS();
+    for (uint32_t row = 0; row < m->Height; ++row)
+        memcpy((uint8_t *)destination + (size_t)(y + row) * (unsigned long)pitch + (size_t)x * 4,
+            m->rgb->data[0] + (size_t)row * (unsigned)m->rgb->linesize[0], (size_t)m->Width * 4);
+    m->copy_ns += SDL_GetTicksNS() - began; return 0;
+}
+static uint32_t movie_u32(uint64_t value) { return value > UINT32_MAX ? UINT32_MAX : (uint32_t)value; }
+void __stdcall BinkGetSummary(HBINK m, void *summary) {
+    if (!summary) return;
+    uint32_t words[31] = {0};
+    if (m) {
+        words[0]=m->Width; words[1]=m->Height; words[2]=movie_u32((SDL_GetTicksNS()-m->opened_ns)/1000000);
+        words[3]=(uint32_t)m->fps.num;words[4]=(uint32_t)m->fps.den;words[5]=words[3];words[6]=words[4];
+        words[8]=m->Frames;words[9]=movie_u32(m->decoded);words[13]=movie_u32(m->copy_ns/1000000);
+        words[14]=movie_u32(m->read_ns/1000000);words[15]=movie_u32(m->video_ns/1000000);words[16]=movie_u32(m->audio_ns/1000000);
+        words[24]=movie_u32((uint64_t)av_rescale((int64_t)m->size,m->fps.num,(int64_t)m->Frames*m->fps.den));
+        words[25]=(uint32_t)(m->size/m->Frames);words[27]=32768;words[28]=32768;
+    }
+    memcpy(summary,words,sizeof(words));
+}
+void __stdcall BinkGetRealtime(HBINK m, void *realtime, unsigned long frames) {
+    (void)frames;
+    if (!realtime) return;
+    uint32_t words[14]={0};
+    if(m) { words[0]=m->FrameNum;words[1]=(uint32_t)m->fps.num;words[2]=(uint32_t)m->fps.den;
+        words[3]=movie_u32(m->decoded);words[4]=movie_u32((SDL_GetTicksNS()-m->opened_ns)/1000000);
+        words[5]=movie_u32(m->video_ns/1000000);words[6]=movie_u32(m->audio_ns/1000000);words[7]=movie_u32(m->read_ns/1000000);
+        words[10]=movie_u32(m->copy_ns/1000000);words[11]=32768;words[12]=32768; }
+    memcpy(realtime,words,sizeof(words));
+}
+void __stdcall BinkClose(HBINK m) {
+    if (!m) return;
+    struct movie_fp state; movie_enter(&state);
+    platform_log("movie closed: %llu decoded frames, %llu draws, %llu queued audio samples, %llu ms%s", (unsigned long long)m->decoded,
+        (unsigned long long)m->presentations, (unsigned long long)m->total_audio_samples,
+        (unsigned long long)(m->started ? (SDL_GetTicksNS()-m->start_ns)/1000000 : 0), m->failed ? " (playback error)" : "");
+    movie_dispose(m); movie_leave(&state);
+}
