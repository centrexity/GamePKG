+static int movie_read(void *opaque, uint8_t *out, int requested) {
+    HBINK m = opaque;
+    if (requested <= 0) return AVERROR(EINVAL);
+    if (m->position >= m->size) return AVERROR_EOF;
+    uint32_t length = (uint64_t)requested < m->size - m->position ?
+        (uint32_t)requested : (uint32_t)(m->size - m->position);
+    uint64_t began = SDL_GetTicksNS();
+    int32_t read = xiso_view_read(m->source, m->position, out, length);
+    m->read_ns += SDL_GetTicksNS() - began;
+    if (read < 0) return AVERROR(EIO);
+    if (!read) return AVERROR_EOF;
+    m->position += (uint32_t)read;
+    return read;
+}
+static int64_t movie_seek(void *opaque, int64_t offset, int whence) {
+    HBINK m = opaque;
+    if (whence == AVSEEK_SIZE) return (int64_t)m->size;
+    whence &= ~AVSEEK_FORCE;
+    int64_t base = whence == SEEK_SET ? 0 : whence == SEEK_CUR ?
+        (int64_t)m->position : whence == SEEK_END ? (int64_t)m->size : -1;
+    if (base < 0 || offset < -base || offset > (int64_t)m->size - base) return AVERROR(EINVAL);
+    m->position = (uint64_t)(base + offset);
+    return (int64_t)m->position;
+}
+static void movie_dispose(HBINK m) {
+    if (!m) return;
+    if (m->output) SDL_DestroyAudioStream(m->output);
+    avcodec_free_context(&m->video_codec);
+    avcodec_free_context(&m->audio_codec);
+    av_frame_free(&m->frame); av_frame_free(&m->rgb); av_packet_free(&m->packet);
+    sws_free_context(&m->scale);
+    if (m->format) avformat_close_input(&m->format);
+    if (m->io) { av_freep(&m->io->buffer); avio_context_free(&m->io); }
+    av_free(m->interleaved);
+    free(m);
