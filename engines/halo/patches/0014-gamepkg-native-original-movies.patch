+static void movie_failure(HBINK m, const char *stage, int error) {
+    char message[128];
+    if (m->failed) return;
+    av_strerror(error, message, sizeof(message));
+    platform_log("movie playback: %s: %s", stage, message);
+    m->failed = 1;
