+static AVCodecContext *movie_codec(HBINK m, int stream) {
+    AVCodecParameters *p = m->format->streams[stream]->codecpar;
+    const AVCodec *codec = avcodec_find_decoder(p->codec_id);
+    if (!codec) return NULL;
+    AVCodecContext *context = avcodec_alloc_context3(codec);
+    if (!context) return NULL;
+    context->thread_count = 1;
+    int error = avcodec_parameters_to_context(context, p);
+    if (error >= 0) error = avcodec_open2(context, codec, NULL);
+    if (error < 0) { movie_failure(m, "open decoder", error); avcodec_free_context(&context); }
+    return context;
