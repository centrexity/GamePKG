+struct movie_fp {
+    fenv_t environment;
+#ifdef __SSE__
+    unsigned mxcsr;
+#endif
+};
+static void movie_enter(struct movie_fp *state) {
+#ifdef __SSE__
+    state->mxcsr = _mm_getcsr();
+#endif
+    fegetenv(&state->environment); fesetenv(FE_DFL_ENV);
+}
+static void movie_leave(const struct movie_fp *state) {
+    fesetenv(&state->environment);
+#ifdef __SSE__
+    _mm_setcsr(state->mxcsr);
+#endif
