ninja_required_version = 1.3

# The arguments passed to configure.py, for rerunning it.
linux_cc = clang
rule linux_cc
  command = $linux_cc -MMD -MF $out.d $cflags -c $in -o $out
  description = LINUX CC $out
  depfile = $out.d
  deps = gcc
rule linux_link
  command = $linux_cc $ldflags -o $out @$out.rsp $libs
  description = LINUX LINK $out
  rspfile = $out.rsp
  rspfile_content = $in_newline
rule linux_tool_link
  command = $linux_cc $ldflags -o $out @$out.rsp
  description = LINUX LINK $out
  rspfile = $out.rsp
  rspfile_content = $in_newline
rule linux_copy
  command = cp -L $in $out
  description = LINUX COPY $out
build build/linux/SDL3-LICENSE.txt: linux_copy $
    build/linux/third_party/SDL3/LICENSE.txt
build build/linux/obj/source/ai/action_alert.o: linux_cc $
    source/ai/action_alert.c | port/include/xdk/d3d8perf.h $
    port/include/xdk/winbase.h port/include/xdk/windef.h $
    port/include/xdk/xbdm.h port/include/xdk/xbox.h $
    port/include/xdk/xdk_d3d8.h port/include/xdk/xdk_d3d8perf.h $
    port/include/xdk/xdk_dsound.h port/include/xdk/xdk_pdb.h $
    port/include/xdk/xdk_win32.h port/include/xdk/xdk_winsock.h $
    port/include/xdk/xdk_xbdm.h port/include/xdk/xdk_xbox.h $
    port/include/xdk/xdk_xkbd.h port/include/xdk/xkbd.h $
    port/include/xdk/xtl.h port/linux/include/halo_linux_prefix.h $
    build/linux/halo_msvc_semantics.h build/linux/platform_msvc_semantics.h $
    build/linux/third_party/stamp $
    build/gamepkg-compiler.stamp
  cflags = --target=i686-linux-gnu -m32 -fms-extensions -fshort-wchar $
      -malign-double -fcommon -fno-pic -fno-strict-aliasing -fwrapv $
      -fno-delete-null-pointer-checks -freg-struct-return $
      -fno-omit-frame-pointer -ffp-contract=off -O2 -g -fno-builtin-wcslen $
      -fno-builtin-wcsnlen -fno-builtin-wcschr -fno-builtin-wcsrchr $
      -fno-builtin-wcscmp -fno-builtin-wcsncmp -fno-builtin-wcscpy $
      -fno-builtin-wcsncpy -fno-builtin-wcscat -fno-builtin-wcsncat $
      -fno-builtin-wmemchr -fno-builtin-wmemcmp -fno-builtin-wmemcpy $
      -fno-builtin-wmemmove -fno-builtin-wmemset -march=x86-64 $
      --sysroot=build/linux/third_party/sysroot -isystem $
      build/linux/third_party/SDL3/include -DHALO_RELEASE -std=gnu89 $
      -D__STRICT_ANSI__ -w -Wno-error=incompatible-pointer-types $
      -Wno-error=incompatible-function-pointer-types $
      -Wno-error=int-conversion -Wno-error=implicit-function-declaration $
      -Wno-error=implicit-int -Wno-error=return-type -include $
      port/linux/include/halo_linux_prefix.h -include $
      build/linux/halo_msvc_semantics.h -Iport/linux/include -iquote $
      port/linux/game -DDEBUG -Dxbox -Isource -Isource/main $
      -Isource/cseries -Isource/sound -Isource/bink -I"source/saved films" $
      -I"source/saved games" -Isource/cache -Isource/units -Isource/text $
      -Isource/tag_files -Isource/structures -Isource/shell $
      -Isource/shaders -Isource/scenario -Isource/render $
      -Isource/rasterizer -Isource/physics -Isource/objects $
      -Isource/objects/widgets -Isource/networking -Isource/models $
      -Isource/memory -Isource/memory/zlib -Isource/math -Isource/tool $
      -Isource/items -Isource/interface -Isource/input -Isource/hs $
      -Isource/game -Isource/effects -Isource/editor -Isource/dialogs $
      -Isource/devices -Isource/cutscene -Isource/camera $
      -Isource/bungie_net -Isource/bitmaps -Isource/ai -idirafter $
      port/include/xdk 
