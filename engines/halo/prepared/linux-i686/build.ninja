    build/linux/obj/port/third_party/musl-math/src/log2.o $
    build/linux/obj/port/third_party/musl-math/src/log2_data.o $
    build/linux/obj/port/third_party/musl-math/src/log_data.o $
    build/linux/obj/port/third_party/musl-math/src/pow.o $
    build/linux/obj/port/third_party/musl-math/src/pow_data.o $
    build/linux/obj/port/third_party/musl-math/src/sin.o $
    build/linux/obj/port/third_party/musl-math/src/tan.o | $
    tools/linux_link_check.py build/linux/sdl3-build/libSDL3.so.0
  ldflags = --target=i686-linux-gnu -m32 -no-pie -g $
      --sysroot=build/linux/third_party/sysroot -Lbuild/linux/sdl3-build $
      '-Wl,-rpath,$$ORIGIN' -Wl,--disable-new-dtags $
      -Wl,--export-dynamic-symbol=open -Wl,--export-dynamic-symbol=open64 $
      -Wl,--export-dynamic-symbol=openat -Wl,--export-dynamic-symbol=openat64
  libs = -lSDL3 -lm -lpthread -ldl
build build/linux/libSDL3.so.0: linux_copy build/linux/sdl3-build/libSDL3.so.0
build build/linux/obj/tools/map_validate.o: linux_cc tools/map_validate.c | $
    build/linux/third_party/stamp $
    build/gamepkg-compiler.stamp
  cflags = --target=i686-linux-gnu -m32 -std=gnu11 -D_GNU_SOURCE $
      -D_FILE_OFFSET_BITS=64 -fno-pic -O2 -g -Wall -march=x86-64 $
      --sysroot=build/linux/third_party/sysroot -isystem $
      build/linux/third_party/SDL3/include -Iport/linux/src $
      -Iport/third_party/zlib -DZ_PREFIX -Dz_errmsg=z_port_errmsg 
build build/linux/map_validate: linux_tool_link $
    build/linux/obj/tools/map_validate.o $
    build/linux/obj/port/linux/game/tag_validate.o $
    build/linux/obj/port/linux/game/cache_file_formats.o $
    build/linux/obj/port/linux/game/tag_schema_collision.o $
    build/linux/obj/port/linux/game/tag_schema_effects.o $
    build/linux/obj/port/linux/game/tag_schema_groups.o $
    build/linux/obj/port/linux/game/tag_schema_models.o $
    build/linux/obj/port/linux/game/tag_schema_objects.o $
    build/linux/obj/port/linux/game/tag_schema_render.o $
    build/linux/obj/port/linux/game/tag_schema_scenario.o $
    build/linux/obj/port/third_party/zlib/adler32.o $
    build/linux/obj/port/third_party/zlib/crc32.o $
    build/linux/obj/port/third_party/zlib/inffast.o $
    build/linux/obj/port/third_party/zlib/inflate.o $
    build/linux/obj/port/third_party/zlib/inftrees.o $
    build/linux/obj/port/third_party/zlib/uncompr.o $
    build/linux/obj/port/third_party/zlib/zutil.o
  ldflags = --target=i686-linux-gnu -m32 -no-pie -g $
      --sysroot=build/linux/third_party/sysroot -Lbuild/linux/sdl3-build $
      '-Wl,-rpath,$$ORIGIN' -Wl,--disable-new-dtags
build build/linux/brokers.txt: linux_copy port/assets/network/brokers.txt
build linux: phony build/linux/halo build/linux/brokers.txt $
    build/linux/map_validate build/linux/libSDL3.so.0 $
    build/linux/SDL3-LICENSE.txt
