# Native runtime attachment. Build the prepared Rust kit first; no conversion
# or Python runs during this configure/build. The media adapter owns entry/ISO.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../media-bridge/attach.cmake")
function(gamepkg_attach_rust_game)
    if(NOT TARGET burnout3)
        message(FATAL_ERROR "Pinned Takedawn target is missing")
    endif()
    foreach(required GAMEPKG_TAKEDAWN_RUST_ARCHIVE GAMEPKG_TAKEDAWN_RUST_TLS)
        if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
            message(FATAL_ERROR "Set ${required} to its prepared native file")
        endif()
    endforeach()
    get_target_property(original burnout3 SOURCES)
    set(retained)
    set(manual_count 0)
    set(generated_count 0)
    foreach(source IN LISTS original)
        if(source MATCHES "(^|/)recomp/recomp_manual\\.c$")
            math(EXPR manual_count "${manual_count}+1")
        elseif(source MATCHES "(^|/)recomp/gen/recomp_([0-9][0-9][0-9][0-9]|dispatch|stubs_unresolved)\\.c$")
            math(EXPR generated_count "${generated_count}+1")
        elseif(source MATCHES "(^|/)recomp/.*\\.c$")
            message(FATAL_ERROR "Unreviewed C game source: ${source}")
        else()
            list(APPEND retained "${source}")
        endif()
    endforeach()
    # A source kit can omit generated C bodies, retaining the generated headers.
    if(NOT manual_count EQUAL 1 OR (NOT generated_count EQUAL 0 AND NOT generated_count EQUAL 27))
        message(FATAL_ERROR "Unexpected pinned game source inventory")
    endif()
    set_property(TARGET burnout3 PROPERTY SOURCES "${retained}")
    target_sources(burnout3 PRIVATE "${GAMEPKG_TAKEDAWN_RUST_TLS}")
    target_include_directories(burnout3 PRIVATE "${XBOXRECOMP_DIR}/templates/runtime")
    target_link_libraries(burnout3 PRIVATE "${GAMEPKG_TAKEDAWN_RUST_ARCHIVE}")
    set_target_properties(burnout3 PROPERTIES OUTPUT_NAME "burnout3-gamepkg-rust")
    # Rust's prebuilt standard library carries debug sections even in release
    # archives. Remove only that non-executable data; preserve native symbols
    # for crash diagnostics and keep the artifact within the standard cache size.
    target_link_options(burnout3 PRIVATE "LINKER:--strip-debug")
endfunction()
cmake_language(DEFER CALL gamepkg_attach_rust_game)
