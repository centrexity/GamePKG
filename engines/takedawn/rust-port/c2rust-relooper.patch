 /// This is the state we close over while relooping. It accumulates information about which
 /// declarations were supposed to be in scope before they were declared.
+/// Lower a typed CFG with one explicit native loop over its basic-block labels.
+/// Declarations are lifted; their initializers stay at their original sites.
+/// Every original terminal edge leaves the loop through the finish block.
+fn flat_reloop(
+    cfg: Cfg<Label, StmtOrDecl>,
+    mut store: DeclStmtStore,
+) -> (Vec<Stmt>, Vec<Structure<Stmt>>) {
+    let start = cfg.entries;
+    let span = cfg.nodes[&start].span;
+    let mut entries = indexset![start.clone()];
+    entries.extend(cfg.nodes.keys().cloned());
+    let mut lifted = IndexSet::new();
+    let mut branches = IndexMap::new();
+    for (label, block) in cfg.nodes {
+        let mut body = block.body;
+        for stmt in &body {
+            if let StmtOrDecl::Decl(id) = stmt {
+                lifted.insert(*id);
+            }
+        }
+        let terminator = match block.terminator {
+            GenTerminator::End => {
+                // Whole-function CFGs use End both for implicit void returns
+                // and for value-returning tail expressions. Keep both kinds.
+                if let Some(StmtOrDecl::Stmt(Stmt::Expr(expr, None))) = body.last_mut() {
+                    if !matches!(expr, syn::Expr::Return(_)) {
+                        let value = expr.clone();
+                        *expr = syn::parse_quote!(return #value);
+                    }
+                } else {
+                    body.push(StmtOrDecl::Stmt(syn::parse_quote!(return;)));
+                }
+                GenTerminator::End
+            }
+            other => other.map_labels(|target| {
+                assert!(entries.contains(target), "flat CFG has an external edge");
+                StructureLabel::ExitTo(target.clone())
+            }),
+        };
+        branches.insert(label.clone(), vec![Structure::Simple {
+            entries: indexset![label], body, span: block.span, terminator,
+        }]);
+    }
+    let declarations = lifted.iter().flat_map(|id| store.extract_decl(*id).unwrap()).collect();
+    let structures = vec![
+        Structure::Simple { entries: indexset![start.clone()], body: vec![], span,
+            terminator: GenTerminator::Jump(StructureLabel::ExitTo(start)) },
+        Structure::Loop { entries: entries.clone(), body: vec![Structure::Multiple { entries, branches }] },
+    ];
+    (declarations, structures.into_iter().map(|s| s.place_decls(&lifted, &mut store)).collect())
+}
