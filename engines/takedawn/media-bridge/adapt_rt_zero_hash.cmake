# Keep the original texture hash and ownership code. Only the resolved render
# target's backing-memory hash uses the exact zero-prefix shortcut.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Set INPUT and OUTPUT for render-target hash adaptation")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned render-target source")
endif()
file(SHA256 "${INPUT}" hash)
if(NOT hash STREQUAL "599e4afa22886d1a088054251b5e795dff6cd94290cf3f4b0ac67f2c26b0ec29")
    message(FATAL_ERROR "Unreviewed render-target source")
endif()
file(READ "${INPUT}" source)
set(before "    return nv2a_tex_hash(mem + addr, (uint32_t)n, NV2A_TEX_HASH_SEED);")
string(FIND "${source}" "${before}" location)
if(location LESS 0)
    message(FATAL_ERROR "Pinned render-target hash site is missing")
endif()
string(REPLACE "${before}" "    return gamepkg_rt_hash(mem + addr, (uint32_t)n, NV2A_TEX_HASH_SEED);" adapted "${source}")
string(PREPEND adapted "#include \"rt_zero_hash.h\"\n")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${adapted}" @ONLY NEWLINE_STYLE UNIX)
