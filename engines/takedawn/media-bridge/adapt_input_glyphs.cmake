# Host-owned UI adaptation. Stage only the pinned runtime files; never mutate
# upstream or the generated Rust game units. No Python is used at player build.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED KIND)
    message(FATAL_ERROR "Set INPUT, OUTPUT and KIND")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite upstream glyph/input source")
endif()
file(SHA256 "${INPUT}" hash)
file(READ "${INPUT}" source)
if(KIND STREQUAL "glyphs")
    if(NOT hash STREQUAL "5517086127bddbdd381e7cca1c0b2309de5e747a11b999559690555645866499")
        message(FATAL_ERROR "Unreviewed original glyphs.c")
    endif()
    file(TO_CMAKE_PATH "${CMAKE_CURRENT_LIST_DIR}/input_glyphs_policy.h" policy)
    string(REPLACE "static void on_set(int set)" "#include \"${policy}\"\n\nstatic void on_set(int set)" source "${source}")
    string(REPLACE "    nv2a_texrep_set_variant(set);" "    gamepkg_glyphs_base(set);" source "${source}")
    string(REPLACE "    nv2a_texrep_register(k_tex, sizeof k_tex / sizeof k_tex[0]);" "    gamepkg_glyphs_register();" source "${source}")
    string(REPLACE "#else\n\nvoid bo3_glyphs_init(void)" "#else\n\nvoid gamepkg_glyphs_scene(int enabled) { (void)enabled; }\nvoid gamepkg_glyphs_port(unsigned port, int mapped) { (void)port; (void)mapped; }\n\nvoid bo3_glyphs_init(void)" source "${source}")
elseif(KIND STREQUAL "controls")
    if(NOT hash STREQUAL "e004d697735981dd3b4e52f1a161b0474301b69bbda6386fc646778bc1406a7b")
        message(FATAL_ERROR "Unreviewed original controls.c")
    endif()
    # Replace the single-player-only gate with a read-only policy using the
    # original title's controller assignments and individual player states.
    string(FIND "${source}" "static int ctl_driving(void)\n{" gate_begin)
    string(FIND "${source}" "/* BO3_CTL_LOG=" gate_end)
    if(gate_begin LESS 0 OR gate_end LESS gate_begin)
        message(FATAL_ERROR "Pinned original driving gate is missing")
    endif()
    string(SUBSTRING "${source}" 0 ${gate_begin} gate_prefix)
    string(SUBSTRING "${source}" ${gate_end} -1 gate_suffix)
    file(TO_CMAKE_PATH "${CMAKE_CURRENT_LIST_DIR}/input_gameplay_policy.h" gameplay_policy)
    set(source "${gate_prefix}#include \"${gameplay_policy}\"\n\n${gate_suffix}")
    string(REPLACE "#include \"controls.h\"" "#include \"controls.h\"\nvoid gamepkg_glyphs_scene(int);\nvoid gamepkg_glyphs_port(unsigned, int);" source "${source}")
    string(REPLACE "    if (M32(rec) != 2 || !M32(rec + 4))         /* no pad open on this port */\n        return;" "    if (port == 0) gamepkg_glyphs_scene(ctl_driving() && xbox_InputControlScheme() == 1);\n    if (M32(rec) != 2 || !M32(rec + 4)) {\n        gamepkg_glyphs_port(port, 0);\n        return;\n    }" source "${source}")
    string(REPLACE "    if (!scheme && !s_port[port].ps2 && !s_port[port].latch && !s_log && !s_scripted_too)\n        return;" "    if (!scheme && !s_port[port].ps2 && !s_port[port].latch && !s_log && !s_scripted_too) {\n        gamepkg_glyphs_port(port, 0);\n        return;\n    }" source "${source}")
    string(REPLACE "    bo3_ctl_apply(&s_port[port], g, ps2, nintendo);" "    bo3_ctl_apply(&s_port[port], g, ps2, nintendo);\n    gamepkg_glyphs_port(port, ps2);" source "${source}")
    string(REPLACE "esc ? ctl_driving() : 0" "esc ? gamepkg_ctl_port_driving(port) : 0" source "${source}")
    string(REPLACE "    driving = ctl_driving();" "    driving = gamepkg_ctl_port_driving(port);" source "${source}")
    string(REPLACE "return g_xbox_mem_offset ? ctl_driving() : 0;" "return g_xbox_mem_offset ? gamepkg_ctl_port_driving(2) : 0;" source "${source}")
else()
    message(FATAL_ERROR "Unreviewed input adaptation kind")
endif()
file(WRITE "${OUTPUT}.tmp" "${source}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
