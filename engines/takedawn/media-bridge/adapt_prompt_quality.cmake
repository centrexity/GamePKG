if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED KIND)
    message(FATAL_ERROR "Set INPUT, OUTPUT and KIND")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned prompt renderer source")
endif()
file(SHA256 "${INPUT}" hash)
file(READ "${INPUT}" source)
if(KIND STREQUAL "scale")
    set(expected "a177881d2e6ef64c8885f901eb066ab136f4a599e4ec83d734f8fe38c95104f8")
    set(before "    if (!pic_from_argb(&a, src, (int)w, (int)h))")
    set(after "    if (gamepkg_prompt_scale(src, w, h, factor, dst)) return 1;\n${before}")
elseif(KIND STREQUAL "store")
    set(expected "bda38b2a2bcb232037ff7cd549a8dd58df3ce0cce5647251040787c92626315e")
    set(before "    pthread_mutex_lock(&s_mx);\n    if (dst && !(flags & NV2A_TEXSCALE_DISK_ONLY))")
    # Serve pre-rendered prompts before disk/memory cache lookup, so an old
    # Super-xBR entry cannot hide the new vector art. No worker queue or I/O.
    set(after "    if (texels && dst && !(flags & NV2A_TEXSCALE_DISK_ONLY)\n            && gamepkg_prompt_scale(texels, w, h, factor, dst)) return NV2A_TEXSCALE_READY;\n${before}")
elseif(KIND STREQUAL "overlay")
    set(expected "40a946fe5e2aecb9019138d08b9d5f3e956ac51ab243faab0270219baf09b1c3")
    set(before "    out = base;\n    if (set < 1")
    set(after "    out = base;\n    if (gamepkg_prompt_sheet(set, out.data())) return true;\n    if (set < 1")
elseif(KIND STREQUAL "backend")
    set(expected "574e5ef47bf1aaa9f197821f2cd725e5b38dc6d86e271c036a36e56b3f01998d")
    set(before "return f == 4 ? 3u : f == 2 ? 2u : 1u;")
    set(after "return f >= 3 ? 3u : f == 2 ? 2u : 1u;")
elseif(KIND STREQUAL "overlay_ui")
    set(expected "fa65f9b9d01c7a4afeff4e7967d00ae611cc31f5303312754de5055c5580fb9a")
    set(before "\"Off\", \"2x\", \"4x\", NULL")
    set(after "\"Off\", \"2x\", \"3x\", \"4x\", NULL")
else()
    message(FATAL_ERROR "Unsupported prompt renderer kind")
endif()
if(NOT hash STREQUAL expected)
    message(FATAL_ERROR "Unreviewed prompt renderer source")
endif()
string(FIND "${source}" "${before}" location)
if(location LESS 0)
    message(FATAL_ERROR "Pinned prompt renderer hook is missing")
endif()
string(REPLACE "${before}" "${after}" source "${source}")
if(KIND STREQUAL "scale" OR KIND STREQUAL "store")
    string(REPLACE "factor != 2 && factor != 4" "factor < 2 || factor > 4" source "${source}")
endif()
if(KIND STREQUAL "scale")
    # Area resampling introduces fractional alpha below 1/255. When that
    # rounds to alpha=1, preserve straight RGB rather than darkening edges.
    # Leave the existing 2x/4x byte outputs unchanged.
    string(REPLACE "pic_to_argb(const Pic *s, uint32_t *dst)" "pic_to_argb(const Pic *s, uint32_t *dst, unsigned factor)" source "${source}")
    string(REPLACE "t[3] < 1.0f / 255.0f ? 1.0f / 255.0f : t[3]" "factor != 3 && t[3] < 1.0f / 255.0f ? 1.0f / 255.0f : t[3]" source "${source}")
    string(REPLACE "pic_to_argb(&b, dst);" "pic_to_argb(&b, dst, factor);" source "${source}")
    string(REPLACE "if (factor == 4) {" "if (factor >= 3) {" source "${source}")
    string(REPLACE "    free(a.p);\n    {" "    free(a.p);\n    if (factor == 3 && algo != NV2A_TEXSCALE_BICUBIC) {\n        if (!gamepkg_pic_three(&b, &c)) { free(b.p); return 0; }\n        free(b.p); b = c;\n    }\n    {" source "${source}")
    string(REPLACE "f = e && e[0] == '2' ? 2u : e && e[0] == '4' ? 4u : 0u;" "f = e && e[0] >= '2' && e[0] <= '4' ? (unsigned)(e[0] - '0') : 0u;" source "${source}")
    string(REPLACE "/* Past an edge: the edge texel. */" "#include \"upscale_three.h\"\n/* Past an edge: the edge texel. */" source "${source}")
elseif(KIND STREQUAL "backend")
    string(REPLACE "    nv2a_texscale_mips(s_scaled, w, h, levels);" "    while (levels > 1 && (1u << (levels - 1)) > (w > h ? w : h)) --levels;\n    nv2a_texscale_mips(s_scaled, w, h, levels);" source "${source}")
elseif(KIND STREQUAL "overlay_ui")
    string(REPLACE "at 2x or 4x" "at 2x, 3x or 4x" source "${source}")
endif()
set(source "#include \"prompt_art.h\"\n${source}")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
