if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Set INPUT and OUTPUT")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned input source")
endif()
if(NOT DEFINED KIND)
    set(KIND backend)
endif()
file(SHA256 "${INPUT}" hash)
if(KIND STREQUAL "core")
    if(NOT hash STREQUAL "6ea3903d962aea341e91b7acf775e21db5f3e6d24177586e5169a1bc1eff9aa8")
        message(FATAL_ERROR "Unreviewed native input core")
    endif()
    file(READ "${INPUT}" source)
    set(before "return !g_probed[port] || g_connected[port]")
    set(after "/* The GamePKG host provider owns physical probing/backoff. A logical\n     * slot may acquire a device at any poll; do not hide its first press\n     * behind the legacy disconnected-port timer. Fake/test backends keep\n     * the original policy. */\n    return g_be == &xbox_input_host_backend || !g_probed[port] || g_connected[port]")
    string(FIND "${source}" "${before}" location)
    if(location LESS 0)
        message(FATAL_ERROR "Pinned input probe predicate is missing")
    endif()
    string(REPLACE "${before}" "${after}" source "${source}")
    set(before "if (g_be->now_ms() - g_last_probe[dwPort] >= XBOX_INPUT_PROBE_MS)")
    set(after "if (g_be == &xbox_input_host_backend || g_be->now_ms() - g_last_probe[dwPort] >= XBOX_INPUT_PROBE_MS)")
    string(FIND "${source}" "${before}" location)
    if(location LESS 0)
        message(FATAL_ERROR "Pinned connection-mask probe is missing")
    endif()
    string(REPLACE "${before}" "${after}" source "${source}")
    file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
    return()
elseif(NOT KIND STREQUAL "backend")
    message(FATAL_ERROR "Unknown native input source kind")
endif()
file(SHA256 "${INPUT}" hash)
if(NOT hash STREQUAL "316fe27024ec06ccf72cd6cd08b8602de87dd94843e2be7f99ad243eae47ae9c")
    message(FATAL_ERROR "Unreviewed native controller source")
endif()
file(READ "${INPUT}" source)
foreach(pair IN ITEMS include get set shutdown)
    if(pair STREQUAL "include")
        set(before "#pragma comment(lib, \"xinput.lib\")")
        set(after "#pragma comment(lib, \"xinput1_4.lib\")\n#include \"native_xinput.h\"")
    elseif(pair STREQUAL "get")
        set(before "DWORD rc = XInputGetState(port, &xi);")
        set(after "DWORD rc = gamepkg_xinput_get_state(port, &xi);")
    elseif(pair STREQUAL "set")
        set(before "return XInputSetState(port, &xv);")
        set(after "return gamepkg_xinput_set_state(port, &xv);")
    else()
        set(before "NULL, xi_get_state, xi_set_state, xbox_InputKeyboardPoll, xi_now_ms, NULL")
        set(after "NULL, xi_get_state, xi_set_state, xbox_InputKeyboardPoll, xi_now_ms, gamepkg_xinput_shutdown")
    endif()
    string(FIND "${source}" "${before}" location)
    if(location LESS 0)
        message(FATAL_ERROR "Pinned controller adaptation point is missing: ${pair}")
    endif()
    string(REPLACE "${before}" "${after}" source "${source}")
endforeach()
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
