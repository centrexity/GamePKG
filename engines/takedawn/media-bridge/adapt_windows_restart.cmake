# Preserve the original shutdown/request/cancel logic. Only replace ownership
# of the next Windows process, at the final original exit handler.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Set INPUT and OUTPUT")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite upstream restart source")
endif()
file(SHA256 "${INPUT}" hash)
if(NOT hash STREQUAL "3eba3080b1525b5ec07b044a0a93f283f2a0a3282a3e4d99d3804b8d6e97e183")
    message(FATAL_ERROR "Unreviewed original recomp_restart.c")
endif()
file(READ "${INPUT}" source)
set(before "    fflush(NULL);\n#if defined(_WIN32)\n")
set(after "    fflush(NULL);\n#if defined(_WIN32)\n    if (gpw_restart_at_exit()) return;\n")
string(REPLACE "${before}" "${after}" adapted "${source}")
if(adapted STREQUAL source)
    message(FATAL_ERROR "Pinned final restart handler is missing")
endif()
file(TO_CMAKE_PATH "${CMAKE_CURRENT_LIST_DIR}/windows_restart.h" header)
string(PREPEND adapted "#if defined(_WIN32)\n#include \"${header}\"\n#endif\n")
file(WRITE "${OUTPUT}.tmp" "${adapted}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
