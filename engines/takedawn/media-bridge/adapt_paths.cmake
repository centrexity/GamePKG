# Stage the two reviewed HDD layout changes without modifying upstream source.
# Used by attach.cmake. The exact source hash pins these substitutions to the
# matching xboxrecomp revision; changed source must be reviewed again.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Set INPUT and OUTPUT for the pinned path adaptation")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite the pinned upstream path source")
endif()
file(SHA256 "${INPUT}" hash)
if(NOT hash STREQUAL "03c89e634abbaf0f168edb853154c006c7e79c15cb1d0f1788cf89a3a54160b2")
    message(FATAL_ERROR "Unreviewed xboxrecomp kernel_path.c; pinned hash does not match")
endif()
file(READ "${INPUT}" source)
set(rule_before [[    { "\\Device\\Harddisk0\\Partition1\\",    0, NULL,         NULL          },]])
set(rule_after [[    { "\\Device\\Harddisk0\\Partition1\\",    1, "\\Partition1", "/Partition1" },]])
string(REPLACE "${rule_before}" "${rule_after}" adapted "${source}")
if(adapted STREQUAL source)
    message(FATAL_ERROR "Pinned Partition1 rule is missing")
endif()
# The Xbox HDD's CACHE directory exists before the title creates its files.
# Keep it separate from the other emulated partitions' Cache directory.
set(dirs_before [[                                      "SystemData" };]])
set(dirs_after [[                                      "SystemData", "Partition1/Cache" };]])
string(REPLACE "${dirs_before}" "${dirs_after}" with_dirs "${adapted}")
if(with_dirs STREQUAL adapted)
    message(FATAL_ERROR "Pinned POSIX device directory list is missing")
endif()
file(WRITE "${OUTPUT}.tmp" "/* GamePKG: pinned source, scoped Partition1 and initial Cache directory. */\n${with_dirs}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
