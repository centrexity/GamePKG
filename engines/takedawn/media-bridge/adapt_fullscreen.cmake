if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Set INPUT and OUTPUT")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned presenter source")
endif()
file(SHA256 "${INPUT}" hash)
if(NOT hash STREQUAL "f291f6052bd41fe1a95353b4f89cb873496f9572150e4bf21770b9d1d5900223")
    message(FATAL_ERROR "Unreviewed SDL presenter source")
endif()
file(READ "${INPUT}" source)
set(before "                if (s_layer)\n                    xbox_OverlayEvent(&ev);")
string(FIND "${source}" "${before}" location)
if(location LESS 0)
    message(FATAL_ERROR "Pinned SDL input dispatch is missing")
endif()
string(REPLACE "${before}" "                const int shortcut = gamepkg_fullscreen_hotkey(&gamepkg_fullscreen_held, &ev);\n                if (shortcut) {\n                    if (shortcut == 2) gamepkg_ToggleFullscreen();\n                    continue;\n                }\n${before}" source "${source}")
set(source "#if defined(XBOXRECOMP_HAVE_OVERLAY)\n#include \"fullscreen_hotkey.h\"\nstatic unsigned gamepkg_fullscreen_held;\n#endif\n${source}")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
