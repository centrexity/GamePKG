if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Set INPUT and OUTPUT")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned input source")
endif()
if(KIND STREQUAL "touch")
    file(SHA256 "${INPUT}" hash)
    if(NOT hash STREQUAL "2b147de120136ef021c71b0934b313cb2d1157aa331eae43ab0aaef4e5c5789d")
        message(FATAL_ERROR "Unreviewed SDL2 touch dispatcher")
    endif()
    file(READ "${INPUT}" source)
    set(before "(int64_t)ev->tfinger.fingerId")
    string(FIND "${source}" "${before}" location)
    if(location LESS 0)
        message(FATAL_ERROR "Pinned SDL2 touch identity is missing")
    endif()
    string(REPLACE "${before}" "gamepkg_sdl2_layout_finger(&ev->tfinger)" source "${source}")
    set(source "#include \"native_sdl2_events.h\"\n${source}")
    file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
    return()
elseif(DEFINED KIND AND NOT KIND STREQUAL "keyboard")
    message(FATAL_ERROR "Unknown SDL2 dispatcher kind")
endif()
file(SHA256 "${INPUT}" hash)
if(NOT hash STREQUAL "eb30d37bc7578c82f60696ac82be22b4adfbb021851a06be3b1f9e0b50eaae86")
    message(FATAL_ERROR "Unreviewed SDL2 keyboard dispatcher")
endif()
file(READ "${INPUT}" source)
set(before "void xbox_InputSdlEvent(const SDL_Event *ev)\n{")
string(FIND "${source}" "${before}" location)
if(location LESS 0)
    message(FATAL_ERROR "Pinned SDL2 event dispatcher is missing")
endif()
string(REPLACE "${before}" "${before}\n    int disposition = gamepkg_sdl2_window_event(ev);\n    if (disposition == GAMEPKG_SDL2_EVENT_DROP) return;\n    if (disposition == GAMEPKG_SDL2_EVENT_RESET) {\n        xbox_InputKeysClear();\n        xbox_InputTouchReleaseAll();\n    }" source "${source}")
set(before "case SDL_KEYUP:\n        vk = xbox_InputSdlKeyToVk(ev->key.keysym.sym);\n        if (vk)\n            xbox_InputKeySet(vk, 0);")
string(FIND "${source}" "${before}" location)
if(location LESS 0)
    message(FATAL_ERROR "Pinned SDL2 key release is missing")
endif()
set(after "case SDL_KEYUP:\n        vk = xbox_InputSdlKeyToVk(gamepkg_sdl2_release_label(&ev->key));\n        if (vk && !gamepkg_sdl2_label_held(gamepkg_sdl2_release_label(&ev->key)))\n            xbox_InputKeySet(vk, 0);")
string(REPLACE "${before}" "${after}" source "${source}")
set(source "#include \"native_sdl2_events.h\"\n${source}")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
