# Maintainer gate: -DINPUT=<pinned kernel_path.c> -DWORK=<private test dir> -P ...
if(NOT DEFINED INPUT OR NOT DEFINED WORK)
    message(FATAL_ERROR "Set INPUT and a fresh WORK directory")
endif()
if(EXISTS "${WORK}")
    message(FATAL_ERROR "WORK must not exist; never reuse or erase another run")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(adapter "${CMAKE_CURRENT_LIST_DIR}/adapt_paths.cmake")
file(SHA256 "${INPUT}" before)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${INPUT}" "-DOUTPUT=${WORK}/adapted.c"
    -P "${adapter}" RESULT_VARIABLE valid)
if(NOT valid EQUAL 0 OR NOT EXISTS "${WORK}/adapted.c")
    message(FATAL_ERROR "Pinned source adaptation failed")
endif()
file(READ "${WORK}/adapted.c" adapted)
string(FIND "${adapted}" [[    { "\\Device\\Harddisk0\\Partition1\\",    1, "\\Partition1", "/Partition1" },]] rule)
string(FIND "${adapted}" [["Partition1/Cache"]] cache)
if(rule LESS 0 OR cache LESS 0)
    message(FATAL_ERROR "Scoped Partition1 or preexisting cache directory is missing")
endif()
file(READ "${INPUT}" source)
file(WRITE "${WORK}/changed.c" "${source}\n/* unreviewed upstream change */\n")
file(WRITE "${WORK}/preserved.c" "previous output must survive rejection\n")
file(SHA256 "${WORK}/preserved.c" expected)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${WORK}/changed.c" "-DOUTPUT=${WORK}/preserved.c"
    -P "${adapter}" RESULT_VARIABLE changed OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${WORK}/preserved.c" actual)
if(changed EQUAL 0 OR NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unreviewed source replaced output")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${INPUT}" "-DOUTPUT=${INPUT}"
    -P "${adapter}" RESULT_VARIABLE overwrite OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${INPUT}" after)
if(overwrite EQUAL 0 OR NOT after STREQUAL before)
    message(FATAL_ERROR "Original pinned source was not preserved")
endif()
message(STATUS "Pinned path staging, source preservation and rejection checks passed")
