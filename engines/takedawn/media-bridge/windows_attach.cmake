# Private Windows native runtime connection. A player kit is not promoted until
# full native link, process isolation and gameplay qualification pass.
function(gamepkg_attach_windows_disc_media)
    if(NOT TARGET burnout3 OR NOT TARGET xbox_kernel OR NOT TARGET xbox_overlay)
        message(FATAL_ERROR "The reviewed native game/kernel/overlay targets are required")
    endif()
    if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "The full reviewed Windows runtime uses Clang native TLS")
    endif()
    set(bridge "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    if(NOT DEFINED GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE OR NOT EXISTS "${GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE}")
        message(FATAL_ERROR "Set GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE to the Windows Rust media static library")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/gamepkg-media")
    get_target_property(kernel_dir xbox_kernel SOURCE_DIR)
    get_target_property(kernel_sources xbox_kernel SOURCES)
    foreach(kind IN ITEMS path memory file)
        if(kind STREQUAL "memory")
            set(name xbox_memory_layout.c)
        else()
            set(name kernel_${kind}.c)
        endif()
        list(FIND kernel_sources "${name}" index)
        if(index LESS 0)
            message(FATAL_ERROR "Pinned ${name} target entry is missing")
        endif()
        set(staged "${CMAKE_BINARY_DIR}/gamepkg-media/${name}")
        if(kind STREQUAL "file")
            set(adapter "${bridge}/adapt_windows_file.cmake")
        elseif(kind STREQUAL "path")
            set(adapter "${bridge}/adapt_paths.cmake")
        else()
            set(adapter "${bridge}/adapt_memory.cmake")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${kernel_dir}/${name}"
            "-DOUTPUT=${staged}" -DWINDOWS_LAYOUT=ON -P "${adapter}" COMMAND_ERROR_IS_FATAL ANY)
        list(REMOVE_AT kernel_sources ${index})
        list(APPEND kernel_sources "${staged}")
    endforeach()
    set_property(TARGET xbox_kernel PROPERTY SOURCES "${kernel_sources}")
    target_include_directories(xbox_kernel PRIVATE "${kernel_dir}")
    get_target_property(game_dir burnout3 SOURCE_DIR)
    get_target_property(game_sources burnout3 SOURCES)
    list(FIND game_sources main.c main_index)
    if(main_index LESS 0)
        message(FATAL_ERROR "Pinned native main target entry is missing")
    endif()
    set(main "${CMAKE_BINARY_DIR}/gamepkg-media/main.c")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${game_dir}/main.c"
        "-DOUTPUT=${main}" -DKIND=main -P "${bridge}/adapt_windows_startup.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT game_sources ${main_index})
    list(APPEND game_sources "${main}")
    set_property(TARGET burnout3 PROPERTY SOURCES "${game_sources}")
    target_include_directories(burnout3 PRIVATE "${game_dir}")
    get_target_property(overlay_dir xbox_overlay SOURCE_DIR)
    get_target_property(overlay_sources xbox_overlay SOURCES)
    list(FIND overlay_sources overlay_gamefont.cpp font_index)
    if(font_index LESS 0)
        message(FATAL_ERROR "Pinned native font target entry is missing")
    endif()
    set(font "${CMAKE_BINARY_DIR}/gamepkg-media/overlay_gamefont.cpp")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${overlay_dir}/overlay_gamefont.cpp"
        "-DOUTPUT=${font}" -DKIND=font -P "${bridge}/adapt_windows_startup.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT overlay_sources ${font_index})
    list(APPEND overlay_sources "${font}")
    set_property(TARGET xbox_overlay PROPERTY SOURCES "${overlay_sources}")
    target_include_directories(xbox_overlay PRIVATE "${overlay_dir}")
    target_sources(burnout3 PRIVATE "${bridge}/windows_file.c" "${bridge}/windows_stream.c" "${bridge}/windows_entry.c")
    target_link_libraries(burnout3 PRIVATE "${GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE}" ws2_32 userenv bcrypt ntdll)
    set_target_properties(burnout3 PROPERTIES OUTPUT_NAME "burnout3-gamepkg-media")
endfunction()
