if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED KIND)
    message(FATAL_ERROR "Set INPUT, OUTPUT and KIND (main or settings)")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned presentation source")
endif()
file(SHA256 "${INPUT}" hash)
file(READ "${INPUT}" source)
if(KIND STREQUAL "main")
    if(NOT hash STREQUAL "f1df9ac7aa232d23e8e21c8d77608724177e647a43588ce41cf604cf19c658ae")
        message(FATAL_ERROR "Unreviewed Takedawn main.c")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/presentation_policy.cmake")
    gamepkg_takedawn_main_presentation(source source)
elseif(KIND STREQUAL "settings")
    if(NOT hash STREQUAL "2fee68dfe58ef65fedf08b7060996fe415ba3d200ac9f47b04298c003cb6e96d")
        message(FATAL_ERROR "Unreviewed xboxrecomp settings source")
    endif()
    function(gamepkg_setting_default key before_value after_value)
        string(REGEX MATCHALL "[^\n]*SETTING\\(\"${key}\"[^\n]*" rows "${source}")
        list(LENGTH rows count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Pinned setting ${key} is missing or duplicated")
        endif()
        list(GET rows 0 before)
        string(REGEX REPLACE ", ${before_value}\\),$" ", ${after_value})," after "${before}")
        if(before STREQUAL after)
            message(FATAL_ERROR "Pinned default of ${key} differs")
        endif()
        string(REPLACE "${before}" "${after}" updated "${source}")
        set(source "${updated}" PARENT_SCOPE)
    endfunction()
    set(before "XS_INT, XS_RESTART, RENV_RENDER_SCALE, NULL, NULL, 1, 4, 1)")
    string(FIND "${source}" "${before}" location)
    if(location LESS 0)
        message(FATAL_ERROR "Pinned desktop render default is missing")
    endif()
    string(REPLACE "${before}" "XS_INT, XS_RESTART, RENV_RENDER_SCALE, NULL, NULL, 1, 4, 2)" source "${source}")
    gamepkg_setting_default("display.aspect" 0 1)
    gamepkg_setting_default("display.hud_fix" 0 1)
    gamepkg_setting_default("graphics.aa" 0 2)
    gamepkg_setting_default("graphics.sharpen" 0 0.10)
    gamepkg_setting_default("graphics.lod_bias" 0 1)
    gamepkg_setting_default("graphics.ui_scale" 0 1)
    string(REPLACE "\"off\", \"2x\", \"4x\", NULL" "\"off\", \"2x\", \"3x\", \"4x\", NULL" source "${source}")
    string(REPLACE "(int)v == 1 ? 2u : (int)v == 2 ? 4u : 0u" "(int)v >= 1 && (int)v <= 3 ? (unsigned)v + 1u : 0u" source "${source}")
    # A launch mode is the initial state, not a ban on the desktop shortcut.
    string(APPEND source "\nvoid gamepkg_ToggleFullscreen(void)\n{\n    xs_setting *setting = &s_set[XS_DISPLAY_FULLSCREEN];\n    const int locked = setting->locked;\n    setting->locked = 0;\n    xbox_SettingSet(XS_DISPLAY_FULLSCREEN, setting->value == 0.0 ? 1.0 : 0.0);\n    setting->locked = locked;\n}\n")
else()
    message(FATAL_ERROR "Unsupported presentation source kind")
endif()
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
