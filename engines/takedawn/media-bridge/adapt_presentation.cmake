if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED KIND)
    message(FATAL_ERROR "Set INPUT, OUTPUT and KIND (main or settings)")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned presentation source")
endif()
file(SHA256 "${INPUT}" hash)
file(READ "${INPUT}" source)
if(KIND STREQUAL "main")
    if(NOT hash STREQUAL "f1df9ac7aa232d23e8e21c8d77608724177e647a43588ce41cf604cf19c658ae")
        message(FATAL_ERROR "Unreviewed Takedawn main.c")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/presentation_policy.cmake")
    gamepkg_takedawn_main_presentation(source source)
elseif(KIND STREQUAL "settings")
    if(NOT hash STREQUAL "2fee68dfe58ef65fedf08b7060996fe415ba3d200ac9f47b04298c003cb6e96d")
        message(FATAL_ERROR "Unreviewed xboxrecomp settings source")
    endif()
    set(before "XS_INT, XS_RESTART, RENV_RENDER_SCALE, NULL, NULL, 1, 4, 1)")
    set(after "XS_INT, XS_RESTART, RENV_RENDER_SCALE, NULL, NULL, 1, 4, 2)")
    string(FIND "${source}" "${before}" location)
    if(location LESS 0)
        message(FATAL_ERROR "Pinned render default is missing")
    endif()
    string(REPLACE "${before}" "${after}" source "${source}")
else()
    message(FATAL_ERROR "Unsupported presentation source kind")
endif()
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
