  "license": "BSD-3-Clause",
  "specialization": "8086-SSE",
  "adaptations": [
    {
      "file": "source/f32_sqrt.c",
      "before": "((expA - 0x7F)>>1)",
      "after": "((expA - 0x7F - (expA < 0x7F))/2)",
      "reason": "Defined floor division for negative exponent; avoid implementation-defined signed right shift."
    },
    {
      "file": "source/s_roundPackToF32.c",
      "before": "\r\n    roundBits = sig & 0x7F;\r\n",
      "after": "\r\n    roundBits = sig & 0x7F;\r\n    gamepkg_softfloat_unbounded_inexact = (roundBits != 0);\r\n",
      "reason": "Observe inexactness at unbounded-exponent destination precision before denormalization or overflow clamping; required for SSE unmasked fault flags."
    },
    {
      "file": "source/extF80M_mul.c",
      "before": "    uint_fast16_t exp, uiZ64;",
      "after": "    uint_fast16_t uiZ64;",
      "reason": "Remove an unused declaration; no numerical change."
    },
    {
      "file": "source/extF80M_sqrt.c",
      "before": "((expA - 0x3FFF)>>1)",
      "after": "((expA - 0x3FFF - (expA < 0x3FFF))/2)",
      "reason": "Defined floor division for bounded negative exponents; avoid implementation-defined signed shift."
    },
    {
      "file": "source/s_addExtF80M.c",
      "before": "\r\n roundPack:\r\n",
      "after": "\r\n",
      "reason": "Remove an unreferenced label; no numerical change."
    },
    {
      "file": "source/s_shiftRightJamM.c",
      "before": "#include <stdint.h>",
      "after": "#include <stdint.h>\r\n#include <stdlib.h>",
      "reason": "Check the documented positive-distance/nonempty-word preconditions, avoiding an uninitialized-path warning and rejecting invalid host calls."
    },
    {
      "file": "source/s_shiftRightJamM.c",
      "before": "    wordJam = 0;",
      "after": "    if (!size_words || !dist) abort();\r\n    wordJam = 0;",
      "reason": "Enforce existing upstream preconditions before using multiword pointers."
    },
    {
      "file": "source/s_roundPackMToExtF80M.c",
      "before": "    roundingMode = softfloat_roundingMode;",
      "after": "    gamepkg_softfloat_ext80_observe(sign, exp, extSigPtr);\r\n    roundingMode = softfloat_roundingMode;",
      "reason": "Observe the normalized unrounded96bit significand and exponent without changing the numerical algorithm; enables guest C1 and wrapped unmasked range results."
    },
    {
      "file": "source/s_shiftNormSigF128M.c",
      "before": "leadingBit = 0x00010000<<shiftDist;",
      "after": "leadingBit = UINT32_C(0x00010000)<<shiftDist;",
      "reason": "Unsigned32 leading-bit shift: conversion uses distance15, where signed int shift to bit31 has undefined behavior."
    },
    {
      "file": "source/8086-SSE/s_commonNaNToF128M.c",
      "before": "    softfloat_shortShiftRight128M( (const uint32_t *) &aPtr->v0, 16, zWPtr );",
      "after": "    zWPtr[indexWord( 4, 0 )] = (uint32_t) (aPtr->v0>>16);\r\n    zWPtr[indexWord( 4, 1 )] = (uint32_t) (aPtr->v0>>48)\r\n                                | (uint32_t) (aPtr->v64<<16);\r\n    zWPtr[indexWord( 4, 2 )] = (uint32_t) (aPtr->v64>>16);\r\n    zWPtr[indexWord( 4, 3 )] = (uint32_t) (aPtr->v64>>48);",
      "reason": "Use logical payload fields instead of treating the address of v0 as a128bit array; v0 is not the first payload field on big-endian hosts, causing out-of-object reads/writes and corrupt NaN payloads."
    },
    {
      "file": "source/8086-SSE/s_f128MToCommonNaN.c",
      "before": "    softfloat_shortShiftLeft128M( aWPtr, 16, (uint32_t *) &zPtr->v0 );",
      "after": "    zPtr->v64 = (uint64_t) aWPtr[indexWord( 4, 3 )]<<48\r\n                    | (uint64_t) aWPtr[indexWord( 4, 2 )]<<16\r\n                    | aWPtr[indexWord( 4, 1 )]>>16;\r\n    zPtr->v0 = (uint64_t) aWPtr[indexWord( 4, 1 )]<<48\r\n                   | (uint64_t) aWPtr[indexWord( 4, 0 )]<<16;",
      "reason": "Use logical payload fields instead of treating the address of v0 as a128bit array; v0 is not the first payload field on big-endian hosts, causing out-of-object reads/writes and corrupt NaN payloads."
    }
  ],
